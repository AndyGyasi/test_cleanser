@page "/Manageroles"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using CleanserBlazorUI.Data
@using CleanserBlazorUI.Services
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject PasswordResetRequestService Requests
@inject UserEmailService EmailChanger
@attribute [Authorize(Roles = "admin")]

<PageTitle>Manage users · Cleanser</PageTitle>

<header class="cx-page-head">
    <div>
        <div class="cx-crumb">Accounts</div>
        <h1>Manage users</h1>
        <p>Change what each person can do, or remove an account.</p>
    </div>
    <div class="cx-actions">
        <a class="cx-btn cx-btn-primary" href="Account/Register">
            <svg class="cx-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 12a4 4 0 100-8 4 4 0 000 8zM2 20c0-3.3 3.6-6 8-6 1.4 0 2.7.3 3.8.7M19 14v6M16 17h6" /></svg>
            Register user
        </a>
    </div>
</header>

<MudMessageBox @ref="deleteBox" Title="Delete user" CancelText="Cancel">
    <MessageContent>
        Delete <strong>@pendingDelete?.Email</strong>? Their account is removed and this cannot be undone.
    </MessageContent>
    <YesButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error">Delete</MudButton>
    </YesButton>
</MudMessageBox>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="cx-alert @(statusIsError ? "error" : "ok")" role="@(statusIsError ? "alert" : "status")" style="margin-bottom:18px">@statusMessage</div>
}
else if (!string.IsNullOrWhiteSpace(Registered))
{
    <div class="cx-alert ok" role="status" style="margin-bottom:18px">Account created for @Registered. Give them the temporary password yourself (it is not emailed). It works for @((int)TemporaryPassword.Lifetime.TotalDays) days, and they choose their own the first time they sign in.</div>
}

@if (rows.Count(r => r.RequestedUtc is not null) is var askedCount and > 0)
{
    <div class="cx-alert warn" role="status" style="margin-bottom:18px"><span>
        <strong>@askedCount @(askedCount == 1 ? "person has" : "people have") asked for a password reset.</strong>
        They are at the top of the list. Use <strong>Reset password</strong> to give them a temporary password, or dismiss the request.
    </span></div>
}

@if (resetting is not null)
{
    <EditForm Model="ResetInput" OnValidSubmit="ResetPasswordAsync" class="cx-card" style="max-width:560px;margin-bottom:18px">
        <DataAnnotationsValidator />
        <h2>Reset password</h2>

        @if (resetDone)
        {
            <div class="cx-alert ok" role="status"><span>Done. Give the temporary password to <strong>@resetting.Email</strong> yourself; it is not emailed. It works until <strong>@TemporaryPassword.ExpiresUtc(resetUser!)?.ToLocalTime().ToString("d MMM yyyy, HH:mm")</strong>, and they will choose their own the next time they sign in.</span></div>
        }
        else
        {
            <p class="cx-sub" style="margin:0">Sets a new temporary password for <strong>@resetting.Email</strong>. Their old password stops working, and they must choose their own at next sign-in.</p>
        }

        <div class="cx-field">
            <span class="cx-field-row">
                <label for="reset-password">Temporary password</label>
                @if (!resetDone)
                {
                    <button type="button" class="cx-linkbtn" @onclick="GenerateReset"><svg class="cx-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8zM19 16l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7z" /></svg> Generate</button>
                }
            </span>
            <span class="cx-control">
                <svg class="cx-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 11h14v10H5zM8 11V8a4 4 0 018 0v3" /></svg>
                <InputText id="reset-password" @bind-Value="ResetInput.Password" type="text" autocomplete="off" readonly="@resetDone" />
                <button type="button" class="cx-icon-btn cx-eye" data-cx="copy" data-target="reset-password" aria-label="Copy password" title="Copy"><svg class="cx-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 9h10v11H9zM5 15V4h10" /></svg></button>
            </span>
            <ValidationMessage For="() => ResetInput.Password" class="cx-error" />
        </div>

        <div class="cx-actions">
            @if (resetDone)
            {
                <button type="button" class="cx-btn cx-btn-primary" @onclick="CloseReset">Done</button>
            }
            else
            {
                <button type="submit" class="cx-btn cx-btn-primary">Set temporary password</button>
                <button type="button" class="cx-btn cx-btn-ghost" @onclick="CloseReset">Cancel</button>
            }
        </div>
    </EditForm>
}

@if (editing is not null)
{
    <EditForm Model="Input" OnValidSubmit="UpdateUserAsync" class="cx-card" style="max-width:560px;margin-bottom:18px">
        <DataAnnotationsValidator />
        <h2>Edit user</h2>

        <div class="cx-field">
            <label for="edit-email">Email address</label>
            <span class="cx-control">
                <svg class="cx-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18v14H3zM3 7l9 6 9-6" /></svg>
                <InputText id="edit-email" @bind-Value="Input.Email" type="email" autocomplete="off" disabled="@editing.IsMe" />
            </span>
            @if (editing.IsMe)
            {
                <span class="cx-hint">You cannot change your own email here. Ask another administrator.</span>
            }
            else
            {
                <span class="cx-hint">This is what they sign in with. Their access and history stay with them, and they are signed out within a minute.</span>
            }
            <ValidationMessage For="() => Input.Email" class="cx-error" />
        </div>

        <div class="cx-field">
            <label for="edit-role">Role</label>
            <span class="cx-control">
                <InputSelect id="edit-role" @bind-Value="Input.NewUserRoles">
                    <option value="">Select a role</option>
                    @foreach (var role in RoleOptions)
                    {
                        <option value="@role">@RoleLabels.For(role)</option>
                    }
                </InputSelect>
                <svg class="cx-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
            </span>
            <ValidationMessage For="() => Input.NewUserRoles" class="cx-error" />
        </div>

        <div class="cx-actions">
            <button type="submit" class="cx-btn cx-btn-primary">Save changes</button>
            <button type="button" class="cx-btn cx-btn-ghost" @onclick="CancelEdit">Cancel</button>
        </div>
    </EditForm>
}

<div class="cx-card flush">
    <div class="cx-card-head">
        <h2>@Filtered.Count @(Filtered.Count == 1 ? "user" : "users")</h2>
        <label class="cx-control cx-search">
            <svg class="cx-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M11 18a7 7 0 100-14 7 7 0 000 14zM20 20l-3.5-3.5" /></svg>
            <span class="cx-sr-only">Search users</span>
            <input type="search" placeholder="Search by email or role" @bind="search" @bind:event="oninput" />
        </label>
    </div>

    <div class="cx-table-wrap">
        <table class="cx-table cx-stack">
            <thead>
                <tr><th>User</th><th>Role</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @if (loading)
                {
                    @for (var i = 0; i < 4; i++)
                    {
                        <tr><td colspan="4"><div class="cx-skeleton" style="height:22px"></div></td></tr>
                    }
                }
                else if (Filtered.Count == 0)
                {
                    <tr><td colspan="4" class="cx-empty">@(string.IsNullOrWhiteSpace(search) ? "There are no users yet." : $"No users match \"{search}\". Check the spelling.")</td></tr>
                }
                else
                {
                    @foreach (var row in Filtered)
                    {
                        <tr>
                            <td>
                                <div class="cx-cell-user">
                                    <span class="cx-avatar sm">@row.Initial</span>
                                    <span>@row.Email</span>
                                </div>
                            </td>
                            <td>
                                @if (row.Roles.Count == 0)
                                {
                                    <span class="cx-pill warn">No role</span>
                                }
                                else
                                {
                                    @foreach (var role in row.Roles)
                                    {
                                        <span class="cx-pill">@RoleLabels.For(role)</span>
                                    }
                                }
                            </td>
                            <td>
                                <span class="cx-pill @row.StatusTone">@row.Status</span>
                                @if (row.RequestedUtc is not null)
                                {
                                    <span class="cx-pill info">Reset requested</span>
                                }
                                @if (row.Hint is not null)
                                {
                                    <div class="cx-hint" style="margin-top:4px">@row.Hint</div>
                                }
                                @if (row.RequestedUtc is { } requestedAt)
                                {
                                    <div class="cx-hint" style="margin-top:4px">Asked @Ago(requestedAt) &middot; <button type="button" class="cx-linkbtn" @onclick="() => DismissRequestAsync(row)">Dismiss</button></div>
                                }
                            </td>
                            <td class="cx-row-actions">
                                <button type="button" class="cx-btn cx-btn-ghost cx-btn-sm" disabled="@row.IsProtected" @onclick="() => StartEdit(row)">Edit</button>
                                <button type="button" class="cx-btn @(row.RequestedUtc is not null ? "cx-btn-primary" : "cx-btn-ghost") cx-btn-sm" disabled="@(row.IsProtected || row.IsMe)" title="@(row.IsMe ? "Change your own password under My account" : null)" @onclick="() => StartReset(row)">Reset password</button>
                                <button type="button" class="cx-btn cx-btn-danger cx-btn-sm" disabled="@row.IsProtected" @onclick="() => DeleteAsync(row)">Delete</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    // The service account the app itself relies on: it cannot be edited or deleted here.
    private const string ProtectedAccount = "noreply.XDSmonitor@XDSdatagh.com";

    private static readonly string[] RoleOptions = { "admin", "manager", "superuser", "user", "registrar" };

    [SupplyParameterFromQuery(Name = "registered")]
    private string? Registered { get; set; }

    private List<UserRow> rows = new();
    private UserRow? editing;
    private UserRow? resetting;
    private ApplicationUser? resetUser;
    private bool resetDone;
    private ResetModel ResetInput = new();
    private string myEmail = "";
    private UserRow? pendingDelete;
    private MudMessageBox deleteBox = default!;
    private InputModel Input = new();
    private string search = "";
    private bool loading = true;
    private string? statusMessage;
    private bool statusIsError;

    private List<UserRow> Filtered => string.IsNullOrWhiteSpace(search)
        ? rows
        : rows.Where(r => r.Email.Contains(search, StringComparison.OrdinalIgnoreCase)
                          || r.Roles.Any(role => RoleLabels.For(role).Contains(search, StringComparison.OrdinalIgnoreCase))).ToList();

    protected override async Task OnInitializedAsync()
    {
        myEmail = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.Identity?.Name ?? "";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var users = await UserManager.Users.OrderBy(u => u.Email).ToListAsync();
        var asked = (await Requests.OpenAsync()).ToDictionary(r => r.UserId, r => r.RequestedUtc);
        var loaded = new List<UserRow>();
        foreach (var user in users)
        {
            var roles = (await UserManager.GetRolesAsync(user)).ToList();
            loaded.Add(new UserRow
            {
                Id = user.Id,
                RequestedUtc = asked.TryGetValue(user.Id, out var when) ? when : null,
                Email = user.Email ?? user.UserName ?? "",
                Roles = roles.Where(r => !IsMustChange(r)).ToList(),
                Pending = roles.Any(IsMustChange),
                Locked = user.LockoutEnd is { } until && until > DateTimeOffset.UtcNow,
                ExpiresUtc = roles.Any(IsMustChange) ? TemporaryPassword.ExpiresUtc(user) : null,
                IsMe = string.Equals(user.Email, myEmail, StringComparison.OrdinalIgnoreCase)
            });
        }
        rows = loaded.OrderByDescending(r => r.RequestedUtc ?? DateTime.MinValue).ThenBy(r => r.Email).ToList();
        loading = false;
    }

    private static bool IsMustChange(string role) =>
        string.Equals(role, PasswordChangeMiddleware.RoleName, StringComparison.OrdinalIgnoreCase);

    private void Say(string message, bool error = false)
    {
        statusMessage = message;
        statusIsError = error;
        Registered = null;
    }

    private void StartEdit(UserRow row)
    {
        if (row.IsProtected) return;
        resetting = null;
        editing = row;
        Input = new InputModel { Email = row.Email, NewUserRoles = row.Roles.FirstOrDefault() ?? "" };
        statusMessage = null;
    }

    private void CancelEdit() => editing = null;

    private async Task DismissRequestAsync(UserRow row)
    {
        await Requests.ResolveAsync(row.Id, myEmail, "Dismissed");
        await LoadAsync();
    }

    private static string Ago(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        return span.TotalMinutes < 1 ? "just now"
             : span.TotalHours < 1 ? $"{(int)span.TotalMinutes} min ago"
             : span.TotalDays < 1 ? $"{(int)span.TotalHours} h ago"
             : $"{(int)span.TotalDays} d ago";
    }

    // ---- Reset password: an admin gives a person a new temporary password (no email involved) ----

    private void StartReset(UserRow row)
    {
        if (row.IsProtected || row.IsMe) return;
        editing = null;
        resetting = row;
        resetUser = null;
        resetDone = false;
        ResetInput = new ResetModel { Password = TemporaryPassword.Generate() };
        statusMessage = null;
    }

    private void GenerateReset() => ResetInput.Password = TemporaryPassword.Generate();

    private void CloseReset()
    {
        resetting = null;
        resetUser = null;
        resetDone = false;
        ResetInput = new ResetModel();
    }

    private async Task ResetPasswordAsync()
    {
        if (resetting is null || resetting.IsProtected || resetting.IsMe) return;

        var user = await UserManager.FindByEmailAsync(resetting.Email);
        if (user is null)
        {
            Say("That user no longer exists.", error: true);
            CloseReset();
            await LoadAsync();
            return;
        }

        // Works without knowing the old password; changes the security stamp, which also
        // ends any sessions the old password had open.
        var token = await UserManager.GeneratePasswordResetTokenAsync(user);
        var result = await UserManager.ResetPasswordAsync(user, token, ResetInput.Password);
        if (!result.Succeeded)
        {
            Say($"Could not set the password: {string.Join(" ", result.Errors.Select(e => e.Description))}", error: true);
            return; // keep the panel open so the admin can pick another
        }

        // The person must choose their own at next sign-in, within the temporary password's lifetime.
        if (!await UserManager.IsInRoleAsync(user, PasswordChangeMiddleware.RoleName))
        {
            await UserManager.AddToRoleAsync(user, PasswordChangeMiddleware.RoleName);
        }
        user.TemporaryPasswordSetUtc = DateTime.UtcNow;
        await UserManager.UpdateAsync(user);
        await Requests.ResolveAsync(user.Id, myEmail, "Reset");
        await UserManager.SetLockoutEndDateAsync(user, null);   // a reset also lifts a lock-out
        await UserManager.ResetAccessFailedCountAsync(user);

        statusMessage = null;
        resetUser = user;
        resetDone = true;
        await LoadAsync();
    }

    private async Task UpdateUserAsync()
    {
        if (editing is null || editing.IsProtected) return;

        var user = await UserManager.FindByIdAsync(editing.Id);
        if (user is null)
        {
            Say("That user no longer exists.", error: true);
            editing = null;
            await LoadAsync();
            return;
        }

        var changes = new List<string>();

        // Email first: it can be refused (already used, not valid), and then nothing else changes.
        var newEmail = Input.Email.Trim();
        if (!editing.IsMe && !string.Equals(newEmail, editing.Email, StringComparison.Ordinal))
        {
            var problem = await EmailChanger.ChangeAsync(user, newEmail, myEmail);
            if (problem is not null)
            {
                Say(problem, error: true);   // keep the panel open so it can be corrected
                return;
            }
            changes.Add($"email is now {newEmail}");
        }

        // Replace the person's role, but never lift a pending "must set a password" flag:
        // that is only lifted by the person choosing their own password.
        if (!string.Equals(Input.NewUserRoles, editing.Roles.FirstOrDefault(), StringComparison.OrdinalIgnoreCase))
        {
            var current = await UserManager.GetRolesAsync(user);
            var remove = await UserManager.RemoveFromRolesAsync(user, current.Where(r => !IsMustChange(r)).ToList());
            var add = remove.Succeeded ? await UserManager.AddToRoleAsync(user, Input.NewUserRoles) : remove;
            if (!add.Succeeded)
            {
                Say($"{(changes.Count > 0 ? "The email was changed, but " : "")}the role could not be changed: {string.Join(" ", add.Errors.Select(e => e.Description))}", error: true);
                editing = null;
                await LoadAsync();
                return;
            }
            changes.Add($"role is now {RoleLabels.For(Input.NewUserRoles)}");
        }

        Say(changes.Count == 0 ? "Nothing was changed." : $"{newEmail}: {string.Join(" and ", changes)}.");
        editing = null;
        await LoadAsync();
    }

    private async Task DeleteAsync(UserRow row)
    {
        if (row.IsProtected) return;

        pendingDelete = row;
        var confirmed = await deleteBox.ShowAsync();
        if (confirmed != true) return;

        var user = await UserManager.FindByNameAsync(row.Email);
        if (user is null || string.Equals(user.Email, ProtectedAccount, StringComparison.OrdinalIgnoreCase))
        {
            Say("That user could not be deleted.", error: true);
        }
        else
        {
            var result = await UserManager.DeleteAsync(user);
            if (result.Succeeded) await Requests.ResolveAsync(user.Id, myEmail, "Account deleted");
            if (result.Succeeded) Say($"{row.Email} was deleted.");
            else Say($"Could not delete {row.Email}: {string.Join(" ", result.Errors.Select(e => e.Description))}", error: true);
        }

        if (editing?.Email == row.Email) editing = null;
        await LoadAsync();
    }

    private sealed class UserRow
    {
        public string Id { get; set; } = "";
        public DateTime? RequestedUtc { get; set; }
        public string Email { get; set; } = "";
        public List<string> Roles { get; set; } = new();
        public bool Pending { get; set; }
        public bool Locked { get; set; }

        public DateTime? ExpiresUtc { get; set; }
        public bool IsMe { get; set; }

        public bool Expired => Pending && ExpiresUtc is { } until && until < DateTime.UtcNow;
        public string? Hint => !Pending || ExpiresUtc is not { } until
            ? null
            : Expired ? $"Expired {until.ToLocalTime():d MMM, HH:mm}. Reset the password." : $"Expires {until.ToLocalTime():d MMM, HH:mm}";

        public string Initial => Email.Length > 0 ? Email[..1].ToUpperInvariant() : "?";
        public bool IsProtected => string.Equals(Email, ProtectedAccount, StringComparison.OrdinalIgnoreCase);
        public string Status => Locked ? "Locked" : Expired ? "Password expired" : Pending ? "Pending password" : "Active";
        public string StatusTone => Locked || Expired ? "bad" : Pending ? "warn" : "ok";
    }

    private sealed class ResetModel
    {
        [Required(ErrorMessage = "Enter or generate a temporary password.")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "The temporary password must be at least 8 characters long.")]
        public string Password { get; set; } = "";
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Enter an email address.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Choose a role.")]
        [Display(Name = "Role")]
        [AllowedWordsAttribute("admin", "manager", "superuser", "user", "registrar")]
        public string NewUserRoles { get; set; } = "";
    }
}
