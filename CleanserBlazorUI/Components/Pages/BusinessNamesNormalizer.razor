@page "/Business-names-normalizer"
@rendermode InteractiveServer
@inject DataManagementService DataManagementService
@inject IDialogService DialogService


@attribute [Authorize(Roles = "admin")]
<div class="cx-page cx-clean">
    <header class="cx-page-head">
        <div>
            <span class="cx-crumb">Data cleaning</span>
            <h1>Business name mapping</h1>
            <p>Replace a short or abbreviated business name with its full name when files are cleaned.</p>
        </div>
    </header>

<MudAlert Class="@AlertSeverityVisible" Severity="@AlertSeverity">@AlertSeverityMessage</MudAlert>

    <section class="cx-card">
        <div class="cx-card-head"><h2 class="cx-card-title">Add a mapping</h2></div>
        <div class="cx-actions">
            <label class="cx-field cx-grow">Replace this<input class="cx-input" @bind="short_value" @bind:event="oninput" /></label>
            <label class="cx-field cx-grow">With this<input class="cx-input" @bind="long_value" @bind:event="oninput" /></label>
            <button type="button" class="cx-btn cx-btn-primary cx-align-end" @onclick="AddBusinessNamesValue">Save changes</button>
        </div>
    </section>

    <section class="cx-card">
        <div class="cx-card-head">
            <h2 class="cx-card-title">Saved mappings</h2>
            <span class="cx-badge">@BusinessNamesSettings.Count</span>
        </div>
        @if (BusinessNamesSettings.Count == 0)
        {
            <div class="cx-empty">No mappings saved yet.</div>
        }
        else
        {
            <div class="cx-table-wrap">
                <table class="cx-table">
                    <thead>
                        <tr><th>Short name</th><th>Full name</th><th>Date created</th><th>Last modified</th><th class="cx-col-actions">Actions</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var bs in BusinessNamesSettings)
                        {
                            <tr>
                                <td>@bs.ShortValue</td>
                                <td>@bs.LongValue</td>
                                <td>@bs.DateCreated</td>
                                <td>@bs.DateModified</td>
                                <td class="cx-col-actions">
                                    @* Edit has never been wired up on this page; kept visible but switched off. *@
                                    <button type="button" class="cx-btn cx-btn-ghost cx-btn-sm" disabled title="Editing is not available yet">Edit</button>
                                    <button type="button" class="cx-btn cx-btn-ghost cx-btn-sm cx-btn-danger" @onclick="@(() => DeleteBusinessNamesValue(bs))">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@code {
    private CancellationTokenSource cancellationTokenSource;
    private MudBlazor.Severity AlertSeverity { get; set; } = MudBlazor.Severity.Success;
    private string AlertSeverityVisible = "d-none";
    private string AlertSeverityMessage = string.Empty;
    private string short_value { get; set; } = string.Empty;
    private string long_value { get; set; } = string.Empty;
    private BusSettNormalizer settingsClass;
    private List<BusSettNormalizer> BusinessNamesSettings = new();
    private List<BusSettNormalizer> settingData = new();
    private StringHelper stringHelper = new StringHelper();


    private int id;
    private SettingsDataType dataType;
    private DateTime dateCreated;
    private DateTime dateModified;

























    protected override async Task OnInitializedAsync()
    {
        settingData = await DataManagementService.BUS_NUM_InitializeSettingsDBAsyncNormalizer();
        BusinessNamesSettings = await DataManagementService.BUS_NUM_GetAllSettingsAsync();
        string AlertSeverityVisible = "d-none";
    }

    private async Task AddBusinessNamesValue()
    {
        if (dateCreated == default)
        {
            dateCreated = DateTime.Now;
        }
        cancellationTokenSource = new CancellationTokenSource();
        settingsClass = new BusSettNormalizer()
            {
                Id = id,
                ShortValue = short_value,
                LongValue = long_value,
                DataType = SettingsDataType.BusinessNamenormalizer,
                DateCreated = dateCreated,
                DateModified = dateModified
            };
        if (!string.IsNullOrWhiteSpace(short_value) && !string.IsNullOrWhiteSpace(long_value) && settingsClass != null)
        {
            var isItem = await DataManagementService.BUS_NUM_GetSettingOne(settingsClass.ShortValue);
            if (isItem == false)
            {
                await DataManagementService.BUS_NUM_AddSettings(settingsClass);
                settingData = new List<BusSettNormalizer>();
                short_value = string.Empty;
                long_value = string.Empty;
                await ShowTextForThreeSecondsAsync(true, cancellationTokenSource.Token);
            }
            else
            {
                await ShowTextForThreeSecondsAsync(false, cancellationTokenSource.Token);
            }
            settingsClass = new BusSettNormalizer();
        }
        BusinessNamesSettings = await DataManagementService.BUS_NUM_GetAllSettingsAsync();
        await InvokeAsync(StateHasChanged);
    }
    private async Task DeleteBusinessNamesValue(BusSettNormalizer item)
    {
        if (item != null)
        {
            await DataManagementService.BUS_NUM_DeleteSetting(item);
        }
        BusinessNamesSettings = await DataManagementService.BUS_NUM_GetAllSettingsAsync();
        await InvokeAsync(StateHasChanged);
    }
    private async Task EditBusinessNamesValue1(BusSettNormalizer _item)
    {
        // BusSettNormalizer item = new();
        // item = _item;
        // isEditselected = true;
        // id = item.Id;
        // dataType = SettingsDataType.BusinessNamenormalizer;
        // dateCreated = item.DateCreated;
        // dateModified = item.DateModified;
        // short_value = item.ShortValue;
        // long_value = item.LongValue;
        // await InvokeAsync(StateHasChanged);
    }
    public async Task ShowTextForThreeSecondsAsync(bool isSuccussfullyAdd, CancellationToken cancellationToken)
    {
        try
        {
            if (isSuccussfullyAdd)
            {
                AlertSeverityVisible = "d-block";
                AlertSeverity = MudBlazor.Severity.Success;
                AlertSeverityMessage = "Added successfully";
            }
            else
            {
                AlertSeverityVisible = "d-block";
                AlertSeverity = MudBlazor.Severity.Error;
                AlertSeverityMessage = "Already Exits";
            }
            await InvokeAsync(StateHasChanged);
            await Task.Delay(3000, cancellationToken);
            AlertSeverityVisible = "d-none";
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
    }
}