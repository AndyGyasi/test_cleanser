@page "/schedule-automatic-cleanup"

@rendermode InteractiveServer
@using CleanserBlazorUI.Data

@inject FileCleanupSettingsService SettingsService


<AuthorizeView Roles="admin">
    <div class="cx-page cx-clean">
        <header class="cx-page-head">
            <div>
                <span class="cx-crumb">Data cleaning</span>
                <h1>Schedule automatic cleanup</h1>
                <p>Choose the hours of the day when old uploaded files are cleared away automatically.</p>
            </div>
        </header>

        <section class="cx-card">
            <div class="cx-card-head"><h2 class="cx-card-title">Cleanup hours</h2></div>
            <div class="cx-form-grid">
                <label class="cx-field">Start hour (0-23)<input class="cx-input" type="number" min="0" max="23" @bind="StartHour" /></label>
                <label class="cx-field">End hour (1-24)<input class="cx-input" type="number" min="1" max="24" @bind="EndHour" /></label>
            </div>
            <div class="cx-actions">
                <button type="button" class="cx-btn cx-btn-primary" disabled="@_processing" aria-busy="@(_processing ? "true" : "false")" @onclick="OpenCleanupSettingsDialog">
                    @(_processing ? "Saving" : "Save changes")
                </button>
            </div>
        </section>
    </div>
</AuthorizeView>
@code {
    public int StartHour { get; set; }
    public int EndHour { get; set; }
    [Inject] IDialogService DialogService { get; set; }
    private bool _processing = false;

    protected override void OnInitialized()
    {
        var settings = SettingsService.GetSettings();
        StartHour = settings.StartHour;
        EndHour = settings.EndHour;
    }

    private async Task OpenCleanupSettingsDialog()
    {
        _processing = true;
        FileCleanupSettings fileCleanupSettings = new();
        fileCleanupSettings.StartHour = StartHour;
        fileCleanupSettings.EndHour = EndHour;
        SettingsService.SaveSettings(fileCleanupSettings);
        await Task.Delay(2000);
        _processing = false;
    }
}
