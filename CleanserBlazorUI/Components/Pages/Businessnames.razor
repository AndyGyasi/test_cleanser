@page "/Businessnames"
@rendermode InteractiveServer
@inject DataManagementService DataManagementService
@inject IDialogService DialogService


@attribute [Authorize(Roles = "admin")]
<div class="cx-page cx-clean">
    <header class="cx-page-head">
        <div>
            <span class="cx-crumb">Data cleaning</span>
            <h1>Business names</h1>
            <p>Names in this list are treated as business names when files are cleaned.</p>
        </div>
    </header>

<MudAlert Class="@AlertSeverityVisible" Severity="@AlertSeverity">@AlertSeverityMessage</MudAlert>

    <section class="cx-card">
        <div class="cx-card-head"><h2 class="cx-card-title">@(editingId == null ? "Add a business name" : "Edit business name")</h2></div>
        <div class="cx-actions">
            <label class="cx-field cx-grow">Business name<input class="cx-input" @bind="text_value" @bind:event="oninput" placeholder="Enter business name here" /></label>
            <button type="button" class="cx-btn cx-btn-primary cx-align-end" @onclick="AddBusinessNamesValue">@(editingId == null ? "Add" : "Save changes")</button>
            @if (editingId != null)
            {
                <button type="button" class="cx-btn cx-btn-ghost cx-align-end" @onclick="CancelEdit">Cancel</button>
            }
        </div>
    </section>

    <section class="cx-card">
        <div class="cx-card-head">
            <h2 class="cx-card-title">Saved business names</h2>
            <span class="cx-badge">@BusinessNamesSettings.Count</span>
        </div>
        @if (BusinessNamesSettings.Count == 0)
        {
            <div class="cx-empty">No business names saved yet.</div>
        }
        else
        {
            <div class="cx-table-wrap">
                <table class="cx-table">
                    <thead><tr><th>Business name</th><th class="cx-col-actions">Actions</th></tr></thead>
                    <tbody>
                        @foreach (var bs in BusinessNamesSettings)
                        {
                            <tr>
                                <td>@bs.Value</td>
                                <td class="cx-col-actions">
                                    <button type="button" class="cx-btn cx-btn-ghost cx-btn-sm" @onclick="@(() => EditBusinessNamesValue(bs))">Edit</button>
                                    <button type="button" class="cx-btn cx-btn-ghost cx-btn-sm cx-btn-danger" @onclick="@(() => DeleteBusinessNamesValue(bs))">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@code {
    private CancellationTokenSource cancellationTokenSource;
    private MudBlazor.Severity AlertSeverity { get; set; } = MudBlazor.Severity.Success;
    string AlertSeverityVisible = "d-none";
    string AlertSeverityMessage = string.Empty;
    public string text_value { get; set; } = string.Empty;
    SettingsClass settingsClass;
    List<SettingsClass> BusinessNamesSettings = new List<SettingsClass>();
    List<string> settingData = new();
    StringHelper stringHelper = new StringHelper();
    protected override async Task OnInitializedAsync()
    {
        settingData = await DataManagementService.InitializeSettingsDBAsync();
        BusinessNamesSettings = await DataManagementService.GetAllSettingsAsync(SettingsDataType.BusinessName);
        string AlertSeverityVisible = "d-none";
    }
    int? editingId;
    void CancelEdit() { editingId = null; text_value = string.Empty; }
    async Task AddBusinessNamesValue()
    {
        cancellationTokenSource = new CancellationTokenSource();
        if (editingId != null)
        {
            var newValue = (text_value ?? string.Empty).Trim().ToUpper();
            if (newValue.Length == 0) return;
            var current = BusinessNamesSettings.FirstOrDefault(x => x.Id == editingId);
            if (current != null && current.Value != newValue && await DataManagementService.GetSettingOne(newValue, SettingsDataType.BusinessName))
            {
                _ = ShowTextForThreeSecondsAsync(false, cancellationTokenSource.Token);
                return;
            }
            await DataManagementService.UpdateSetting(editingId.Value, newValue, SettingsDataType.BusinessName);
            editingId = null; text_value = string.Empty;
            BusinessNamesSettings = await DataManagementService.GetAllSettingsAsync(SettingsDataType.BusinessName);
            _ = ShowTextForThreeSecondsAsync(true, cancellationTokenSource.Token, "Saved successfully");
            return;
        }

        settingsClass = new SettingsClass()
        {
            DataType = SettingsDataType.BusinessName,
            Value = text_value.ToUpper()
        };
        if (!string.IsNullOrWhiteSpace(text_value) && settingsClass != null)
        {
            var isItem = await DataManagementService.GetSettingOne(text_value.ToUpper(), SettingsDataType.BusinessName);
            if (isItem == false)
            {
                await DataManagementService.AddSettings(settingsClass, SettingsDataType.BusinessName);
                text_value = string.Empty;
                // show the new name straight away; the notice then clears itself after 3 seconds
                BusinessNamesSettings = await DataManagementService.GetAllSettingsAsync(SettingsDataType.BusinessName);
                _ = ShowTextForThreeSecondsAsync(true, cancellationTokenSource.Token);
            }
            else
            {
                _ = ShowTextForThreeSecondsAsync(false, cancellationTokenSource.Token);
            }
            settingsClass = new SettingsClass();
            text_value = string.Empty;
        }
        BusinessNamesSettings = await DataManagementService.GetAllSettingsAsync(SettingsDataType.BusinessName);
        await InvokeAsync(StateHasChanged);
    }
    private async Task DeleteBusinessNamesValue(SettingsClass item)
    {
        if (item != null)
        {
            await DataManagementService.DeleteSetting(item, SettingsDataType.BusinessName);
            if (editingId == item.Id) CancelEdit();
        }
        BusinessNamesSettings = await DataManagementService.GetAllSettingsAsync(SettingsDataType.BusinessName);
        await InvokeAsync(StateHasChanged);
    }
    private async Task EditBusinessNamesValue(SettingsClass item)
    {
        text_value = item.Value;
        editingId = item.Id;
        await InvokeAsync(StateHasChanged);
    }


    public async Task ShowTextForThreeSecondsAsync(bool isSuccussfullyAdd, CancellationToken cancellationToken, string successText = "Added successfully")
    {
        try
        {
            if (isSuccussfullyAdd)
            {
                AlertSeverityVisible = "d-block";
                AlertSeverity = MudBlazor.Severity.Success;
                AlertSeverityMessage = successText;
            }
            else
            {
                AlertSeverityVisible = "d-block";
                AlertSeverity = MudBlazor.Severity.Error;
                AlertSeverityMessage = "Already Exits";
            }
            await InvokeAsync(StateHasChanged);
            await Task.Delay(3000, cancellationToken);
            AlertSeverityVisible = "d-none";
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
    }
}
