    async Task DownloadExcelDataStream(byte[] excelData, string targetFilePath)
    {
        string SecuredFileNameOrRawFileName = targetFilePath!;
        if (PRINT_EXCEL_WITH_SECURED_NAME)
        {
            SecuredFileNameOrRawFileName = Path.GetFileName(targetFilePath!);
        }
        else { SecuredFileNameOrRawFileName = GetFileNameFromFile(targetFilePath!); }
        // Trigger download using JavaScript Interop
        await JS.InvokeVoidAsync("downloadFile", SecuredFileNameOrRawFileName, excelData, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        File.Delete(FullExcelDataFilePath!);
    }
    async Task<(List<T> excelDataReceived, SpreadSheetStatusContext spreadSheetStatus)> ReadFromExcelAsync<T>(Stream fileResult, string _filename, int chunkSize = 100)
    {
        return await Task.Run(() =>
        {
            filename = _filename;
            var excelDataReceived = new List<T>();
            var excelDataReceivedRef = new List<T>();
            var spreadSheetStatus = new SpreadSheetStatusContext();

            using (var wb = new XLWorkbook(fileResult))
            {
                // Assumes that the data is in the first worksheet.
                var ws = wb.Worksheet(1);

                // Get all used rows. Alternatively, use ws.Rows() if you want every row.
                var rows = ws.RowsUsed().ToList();
                var headerRow = ws.Row(1);
                if (headerRow == null)
                {
                    // spreadSheetStatus.Errors.Add("Header row is missing.");
                    return (excelDataReceived, spreadSheetStatus);
                }

                // Extract headers from the header row.
                var actualHeaders = headerRow.Cells().Select(cell => cell.GetValue<string>().Trim().ToLower().Replace(" ", "")).ToList();

                if (typeof(T) == typeof(BusinessContext))
                {
                    var busTransformer = new BusinessDataTransformer();
                    var expectedHeaders = SpreadSheetHeadersData.Business.Select(h => h.Trim().ToLower()).ToList();

                    ValidateHeaders(expectedHeaders, actualHeaders, spreadSheetStatus);

                    // If there are header errors, return early.
                    if (spreadSheetStatus.InvalidHeaders.Any())
                    {
                        return (excelDataReceived, spreadSheetStatus);
                    }

                    // Get all data rows (skip header row).
                    var dataRows = rows.Skip(1).ToList();
                    int totalRows = dataRows.Count;
                    int processedRows = 0;

                    // Process rows in chunks.
                    while (processedRows < totalRows)
                    {
                        // Get the next chunk of rows.
                        var currentChunk = dataRows.Skip(processedRows).Take(chunkSize);
                        foreach (var row in currentChunk)
                        {

                            // Create a new BusinessContext instance from the row.
                            // (You can adjust the column indices and mapping as required.)
                            var newItem = (T)(object)new BusinessContext
                            {
                                UNL_NDIA_OldData = busTransformer.UNL_NDIA_OldData(row.Cell(59).GetString()),

