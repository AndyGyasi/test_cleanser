        shortForms = await DataManagementService.BUS_NUM_InitializeSettingsDBAsyncNormalizer_Home();
        settingDataSettings = await DataManagementService.InitializeSettingsDBAsync();

        if (allowedFileNames.Count > 0)
        {
            showSkeleton = "d-none";
            showMainPage = "d-block";
        }
        else
        {
            showMainPage = "d-block";
            showSkeleton = "d-none";
        }
        progressIsVisible = "d-none";
        AlertSeverityVisible = "d-none";


        TopExpandPanelsContent = dataCleaningType.GetDataCleanings();
        _timer = new System.Timers.Timer(5000);
        _timer.Elapsed += OnTimerElapsed;
        _timer.AutoReset = true;



        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var appUser = await UserManager.GetUserAsync(user);

            if (appUser != null)
            {
                var userRoles = await UserManager.GetRolesAsync(appUser);
                if (!userRoles.Contains("MustChangePassword"))
                {
                    userNotAllowed = false;
                }
                else
                {
                    userNotAllowed = true;
                }

            }
        }
        if (userNotAllowed)
        {
            RedirectManager.RedirectTo("Account/Manage/ChangePassword");
        }
    }
