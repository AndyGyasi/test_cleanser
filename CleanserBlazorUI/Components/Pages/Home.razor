    static bool REF_AreAllItemsAvailable(List<string> fileNamesToCheck, List<string> AcceptedFiles)
    {
        if (fileNamesToCheck == null || AcceptedFiles == null)
            return false;

        var availableSet = new HashSet<string>(AcceptedFiles);

        foreach (var item in fileNamesToCheck)
        {
            if (!availableSet.Contains(item))
                return false;
        }

        return true;
    }
    (List<DBIndividualContext> _individualContext, string _correctDateOfBirth, string _dobIssues, string _matchdata) REF_MainMatcherTransformer_IND(List<IndividualRef> savedDatafromOurDatabase, List<DBIndividualContext> recordFromClient)
    {
        int correctDateOfBirth = 0; int dobIssues = 0; int matchdata = 0;

        // Build O(1) lookup index — avoids O(n²) FirstOrDefault inside loop.
        // Uses a manual loop rather than .ToDictionary() -- duplicate
        // (AccNum, CustomerID, DisbursementDate) rows in the reference table
        // would otherwise throw "An item with the same key has already been
        // added" and crash the whole cleaning run; a duplicate just
        // overwrites (last one wins) here instead.
        var savedIndex = new Dictionary<(string, string, string), IndividualRef>();
        foreach (var r in savedDatafromOurDatabase)
        {
            savedIndex[(NormalizeAccountNumber(r.CreditFacilityAccNum), NormalizeCustomerId(r.CustomerID), r.DisbursementDate ?? string.Empty)] = r;
        }

        foreach (var clientRecord in recordFromClient)
        {
            var key = (NormalizeAccountNumber(clientRecord.CreditFacilityAccNum),
                       NormalizeCustomerId(clientRecord.CustomerID),
                       clientRecord.DisbursementDate ?? string.Empty);

            if (!savedIndex.TryGetValue(key, out var matchingSavedRecord))
            {
                clientRecord.Status = string.Empty;
                matchdata++;
            }
            else
            {
                if (matchingSavedRecord.DateOfBirth == clientRecord.DateOfBirth)
                {
                    clientRecord.Status = string.Empty;
                    correctDateOfBirth++;
                }
                else
                {
                    clientRecord.Status = "DOB";
                    dobIssues++;
                }
            }
        }
        return (recordFromClient, correctDateOfBirth.ToString(), dobIssues.ToString(), matchdata.ToString());
    }
