    (List<BusinessContext> allRecords, List<BusinessContext> duplicatesInd, string correctDateOfBirth, string dobIssues, string matchdata, string newdata, string duplicatescount) REF_MainMatcherTransformerInd_Clean_BUS(List<BusinessRef> fromDatabase, List<BusinessContext> fromExcelFileRaw, bool handleDuplicates = true)
    {
        // Flag same-submission overdraft redraws before dedup, mirroring the IND matcher.
        var fromExcelFile = AssignDuplicateDoBIssuesBus(fromExcelFileRaw);

        List<BusinessContext> processedExcelRecords = new();
        List<BusinessContext> duplicatesList = new();

        if (handleDuplicates)
        {
            var seenKeys = new Dictionary<(string, string, string?), BusinessContext>();
            processedExcelRecords = new List<BusinessContext>();
            foreach (var record in fromExcelFile)
            {
                var key = (NormalizeAccountNumber(record.Facilityaccnum?.Data), NormalizeCustomerId(record.CustomerID?.Data), record.DisbursementDate?.Data);
                if (seenKeys.TryGetValue(key, out var existing))
                {
                    // Before treating this as a duplicate to collapse, confirm
                    // it's actually the same business -- the key alone
                    // (AccNum+CustomerID+DisbursementDate) doesn't guarantee
                    // that. Reuses the exact same fuzzy business-name judgment
                    // already trusted for the cross-record conflict check.
                    bool namesConfirmSame = NamesConfirmSameBusiness(new[] { existing, record }, out _);
                    if (!namesConfirmSame)
                    {
                        // Not a duplicate -- a genuine identity conflict on the
                        // same facility. Let it through untouched so
                        // CheckForChangesInCustomerIDBusregnumTinum downstream
                        // sees the full group and flags every one of them for
                        // UNL, instead of one surviving as CLEAN while the rest
                        // silently vanish into the DUP sheet.
                        processedExcelRecords.Add(record);
                        continue;
                    }
                    duplicatesList.Add(record); // Duplicates stored separately //
                }
                else
                {
                    seenKeys[key] = record;
                    processedExcelRecords.Add(record); // Processed records exclude duplicates
                }
            }
        }
        else
        {
            processedExcelRecords = fromExcelFile.ToList();
        }

        // A facility can legitimately have MULTIPLE historical rows (one per
        // DisbursementDate ever seen -- this is the whole point for overdrafts).
        // Keep the full list per key instead of collapsing to the last-seen row,
        // or history for earlier draws silently disappears. Same fix already
        // applied to the IND matcher.
        var databaseDict = new Dictionary<(string, string), List<BusinessRef>>();
        foreach (var dbRecord in fromDatabase)
        {
            var key = (NormalizeAccountNumber(dbRecord.CreditFacilityAccNum), NormalizeCustomerId(dbRecord.CustomerID));
            if (!databaseDict.TryGetValue(key, out var list))
            {
                list = new List<BusinessRef>();
                databaseDict[key] = list;
            }
            list.Add(dbRecord);
        }

        int __correctDateOfBirth = 0;
        int __dobIssues = 0;
        int __matchdata = 0;
        int __newdata = 0;
        int __burscount = 0;

        foreach (var excelRecord in processedExcelRecords)
        {
            var creditFacilityAccNum = NormalizeAccountNumber(excelRecord.Facilityaccnum?.Data);
            var customerID = NormalizeCustomerId(excelRecord.CustomerID?.Data);
            var disbursementDate = excelRecord.DisbursementDate?.Data;

            var key = (creditFacilityAccNum, customerID);

            if (databaseDict.TryGetValue(key, out var dbRecords) && dbRecords.Count > 0)
            {
                var excelDob = excelRecord.DateOfBirth;
                __matchdata++;

                // Overdraft facilities legitimately redraw on new dates -- exempt
                // from the disbursement-date-mismatch rule, same exemption
                // already applied to the IND matcher.
                bool isOverdraft = (excelRecord.CreditFacilityType?.Data ?? string.Empty)
                    .Trim().ToUpperInvariant() == "V";

                var dbRecord = dbRecords.FirstOrDefault(r => r.DisbursementDate == disbursementDate)
                                ?? dbRecords[0];

                bool dateOnFile = dbRecords.Any(r => r.DisbursementDate == disbursementDate);

                // ── Store reference canonical name for validation pass ──
                // Mirrors the IND matcher's Sprint 10 block: if the reference
                // has a business name on file, record it so the validation
                // pass can trust names that were accepted in a prior month's
                // manually-cleaned CLEAN sheet.
                if (!string.IsNullOrWhiteSpace(dbRecord.Businessname))
                {
                    excelRecord.ReferenceCanonicalName =
                        NormaliseNameSortedTokens(dbRecord.Businessname, string.Empty);
                }

                if (!dateOnFile && !isOverdraft)
                {
                    excelRecord.DisburStatus = " THE DISBURSEMENT DATE DOES NOT MATCH THE PREVIOUS SUBMISSION ";
                    __burscount++;
                }
                if (dbRecord.DateOfBirth == excelDob)
                {
                    __correctDateOfBirth++;
                }
                else
                {
                    excelRecord.Status = "DOB";
                    __dobIssues++;
                }
            }
            else
            {
                __newdata++;
            }
        }

        return (processedExcelRecords, duplicatesList, "N/A", "N/A", __matchdata.ToString(), __newdata.ToString(), duplicatesList.Count.ToString());
    }
    // Whether the group's business names confirm this is clearly the same
    // business. A business can legitimately have several Customer IDs and
    // even a corrected registration number/TIN over time -- none of that
    // is inherently suspicious. What actually matters is whether a shared
    // ID value belongs to a genuinely different business. Business names
    // vary far more than person names (trading name vs registered name,
    // "LTD" vs "LIMITED", punctuation), so this compares fuzzily -- the
    // same hyphen/apostrophe/comma-tolerant token matching built for
    // individual names -- rather than requiring exact string equality,
    // which was the dominant cause of false-positive UNL flags here.
    // Zero names to check, or genuinely (fuzzy) different names -> can't
    // confirm -- stay conservative.
    //
    // Abbreviations (e.g. "SCH" for "SCHOOL", "INT'L" for
    // "INTERNATIONAL") are expanded via the same Business Names
    // Normalizer mappings used for keyword validation BEFORE comparing --
    // otherwise "ASSOCIATION INTERNATIONAL SCHOOL" vs "...SCH" would fail
    // plain token-overlap matching despite clearly being the same
    // business. matchedViaFuzzy reports whether any pair only agreed
    // after this fuzzy comparison (not an exact string match), so callers
    // can surface a warning rather than treating it as a silent pass.
    //
    // Class-level (not a local function) so both the cross-record conflict
    // check (CheckForChangesInCustomerIDBusregnumTinum) and the dedup pass
    // (REF_MainMatcherTransformerInd_Clean_BUS) can reuse the exact same
    // "is this the same business" judgment.
    bool NamesConfirmSameBusiness(IEnumerable<BusinessContext> grp, out bool matchedViaFuzzy)
    {
        matchedViaFuzzy = false;
        string NormReg(string? v) => (v ?? string.Empty).Trim().ToUpperInvariant();
        var distinctNames = grp
            .Where(r => r.Businessname != null && !string.IsNullOrWhiteSpace(r.Businessname.Data))
            .Select(r => NormReg(r.Businessname.Data))
            .Distinct()
            .ToList();

        if (distinctNames.Count == 0) return false;
        if (distinctNames.Count == 1) return true;

        var expandedNames = distinctNames.Select(n => ConvertBusinessShortFormToLongForm(n)).ToList();

        for (int i = 0; i < expandedNames.Count; i++)
            for (int j = i + 1; j < expandedNames.Count; j++)
            {
                if (string.Equals(expandedNames[i], expandedNames[j], StringComparison.OrdinalIgnoreCase))
                    continue; // exact match once abbreviations are expanded

                var (_, _, isSame, _) = CompareNameTokens(expandedNames[i], string.Empty, string.Empty, expandedNames[j], string.Empty, string.Empty);
                if (!isSame) return false;
                matchedViaFuzzy = true;
            }
        return true;
    }
    List<BusinessContext> CheckForChangesInCustomerIDBusregnumTinum(List<BusinessContext> list)
    {
        if (list == null)
            throw new ArgumentNullException(nameof(list));

        // Trim + case-fold before comparing Busregnum/Tinum -- these are compared
        // as plain strings, so any invisible whitespace or case difference
        // between two otherwise-identical values (e.g. from how Excel stored a
        // cell) would make them count as "different" and force a false conflict,
        // exactly as reported: a Tinum that looked identical across a group was
        // still triggering distinctTinums > 1 because it was never normalized.
        string NormReg(string? v) => (v ?? string.Empty).Trim().ToUpperInvariant();

        // For judging whether two values are GENUINELY different, strip every
        // non-alphanumeric character too -- e.g. "CA17,844" vs "CA17844" is a
        // stray comma, not a different registration number, and shouldn't be
        // counted as a conflict just because the raw strings don't match
        // exactly. Messages below still display the original NormReg'd values
        // (not this stripped form), so the formatting difference itself stays
        // visible even though it isn't treated as a real conflict.
        string NormRegStrict(string? v) => new string(NormReg(v).Where(char.IsLetterOrDigit).ToArray());

        // NamesConfirmSameBusiness is now a class-level method (see below) so
        // the dedup pass in REF_MainMatcherTransformerInd_Clean_BUS can reuse
        // it too, not just this check.

        // Values like "0000", "STAFF", "VOTERS" are placeholders/category
        // labels, not real registration numbers or TINs -- mirrors the
        // Individual-side IsValidIDValue fix. Without this, two genuinely
        // unrelated businesses sharing the same placeholder in the same
        // column (very common -- "0000" especially) would be grouped
        // together and, since their business names obviously differ, flagged
        // as a false 'shared ID belongs to a different business' conflict.
        bool IsValidBusinessIdValue(string? value)
        {
            if (string.IsNullOrWhiteSpace(value)) return false;
            var v = NormRegStrict(value);
            if (v.Length < 5) return false;
            if (v.Distinct().Count() == 1) return false; // all-same-character, e.g. "0000000"
            if (!v.Any(char.IsDigit)) return false;       // alpha-only, e.g. "STAFF", "VOTERS"
            return true;
        }

        void AddFuzzyWarning(IEnumerable<BusinessContext> grp, string warnMsg)
        {
            foreach (var rec in grp)
                rec.BusinessNameFuzzyMatchNote = string.IsNullOrWhiteSpace(rec.BusinessNameFuzzyMatchNote)
                    ? warnMsg : rec.BusinessNameFuzzyMatchNote + " | " + warnMsg;
        }

        // Group by Customer ID and check for a genuinely different business
        // (by name) using the same Customer ID. A business having several
        // Customer IDs is fine (not checked here -- see the Busregnum/Tinum
        // passes below), but the reverse -- the SAME Customer ID linked to
        // two clearly different businesses, e.g. "ABEIKUMAH CONSTRUCTION..."
        // vs "ASSOCIATION INTERNATIONAL SCHOOL" -- is a real identity
        // conflict. Fuzzy name variants (abbreviations, suffixes like
        // "-LOAN ACCOUNT") are NOT conflicts here either.
        var customerGroups = list
            .Where(r => r.CustomerID != null && !string.IsNullOrEmpty(r.CustomerID.Data))
            .GroupBy(r => NormalizeCustomerId(r.CustomerID.Data));

        foreach (var grp in customerGroups)
        {
            var distinctNamesCount = grp
                .Where(r => r.Businessname != null && !string.IsNullOrWhiteSpace(r.Businessname.Data))
                .Select(r => NormReg(r.Businessname.Data))
                .Distinct()
                .Count();
            if (distinctNamesCount <= 1) continue;

            bool namesConfirmSame = NamesConfirmSameBusiness(grp, out bool matchedViaFuzzy);
            var nameList = grp.Where(r => r.Businessname != null && !string.IsNullOrWhiteSpace(r.Businessname.Data))
                .Select(r => NormReg(r.Businessname.Data)).Distinct();

            if (!namesConfirmSame)
            {
                var msg = $"CUSTOMER ID {grp.Key} IS LINKED TO DIFFERENT BUSINESSES: {string.Join(", ", nameList)} — VERIFY WHICH IS CORRECT";
                foreach (var rec in grp)
                    rec.CustomerIDBusregnumTinumStatus = string.IsNullOrWhiteSpace(rec.CustomerIDBusregnumTinumStatus)
                        ? msg : rec.CustomerIDBusregnumTinumStatus + " | " + msg;
            }
            else if (matchedViaFuzzy)
            {
                AddFuzzyWarning(grp, $"CUSTOMER ID {grp.Key}: BUSINESS NAME VARIES ACROSS RECORDS ({string.Join(", ", nameList)}) — TREATED AS THE SAME BUSINESS (FUZZY MATCH)");
            }
        }

        // Group by Busregnum and check for a genuinely different business
        // (by name) sharing it, or multiple TINs under it without name
        // agreement. Customer ID plurality is intentionally NOT checked here
        // -- a business having several Customer IDs is normal, not a signal.
        var busregGroups = list
            .Where(r => IsValidBusinessIdValue(r.Busregnum?.Data))
            .GroupBy(r => NormRegStrict(r.Busregnum.Data));

        foreach (var grp in busregGroups)
        {
            var distinctTinums = grp
                .Where(r => IsValidBusinessIdValue(r.Tinum?.Data))
                .Select(r => NormRegStrict(r.Tinum.Data))
                .Distinct()
                .Count();

            bool namesConfirmSame = NamesConfirmSameBusiness(grp, out bool matchedViaFuzzy);
            bool tinumConflict = distinctTinums > 1 && !namesConfirmSame;

            if (tinumConflict)
            {
                var tinList = grp.Where(r => IsValidBusinessIdValue(r.Tinum?.Data))
                    .Select(r => NormReg(r.Tinum.Data)).Distinct();
                var msg = $"REGISTRATION NUMBER {NormReg(grp.First().Busregnum?.Data)} IS SHARED WITH MULTIPLE TINS {string.Join(", ", tinList)} — BUSINESS NAMES DON'T MATCH, VERIFY THIS IS THE SAME BUSINESS";
                foreach (var rec in grp)
                    rec.CustomerIDBusregnumTinumStatus = string.IsNullOrWhiteSpace(rec.CustomerIDBusregnumTinumStatus)
                        ? msg : rec.CustomerIDBusregnumTinumStatus + " | " + msg;
            }
            else if (namesConfirmSame && matchedViaFuzzy)
            {
                var nameList = grp.Where(r => r.Businessname != null && !string.IsNullOrWhiteSpace(r.Businessname.Data))
                    .Select(r => NormReg(r.Businessname.Data)).Distinct();
                AddFuzzyWarning(grp, $"REGISTRATION NUMBER {NormReg(grp.First().Busregnum?.Data)}: BUSINESS NAME VARIES ACROSS RECORDS ({string.Join(", ", nameList)}) — TREATED AS THE SAME BUSINESS (FUZZY MATCH)");
            }
        }

        // Group by Tinum -- mirror of the Busregnum pass above.
        var tinumGroups = list
            .Where(r => IsValidBusinessIdValue(r.Tinum?.Data))
            .GroupBy(r => NormRegStrict(r.Tinum.Data));

        foreach (var grp in tinumGroups)
        {
            var distinctBusregnums = grp
                .Where(r => IsValidBusinessIdValue(r.Busregnum?.Data))
                .Select(r => NormRegStrict(r.Busregnum.Data))
                .Distinct()
                .Count();

            bool namesConfirmSame = NamesConfirmSameBusiness(grp, out bool matchedViaFuzzy);
            bool busregConflict = distinctBusregnums > 1 && !namesConfirmSame;

            if (busregConflict)
            {
                var regList = grp.Where(r => IsValidBusinessIdValue(r.Busregnum?.Data))
                    .Select(r => NormReg(r.Busregnum.Data)).Distinct();
                var msg = $"TIN {NormReg(grp.First().Tinum?.Data)} IS SHARED WITH MULTIPLE REGISTRATION NUMBERS {string.Join(", ", regList)} — BUSINESS NAMES DON'T MATCH, VERIFY THIS IS THE SAME BUSINESS";
                foreach (var rec in grp)
                    rec.CustomerIDBusregnumTinumStatus = string.IsNullOrWhiteSpace(rec.CustomerIDBusregnumTinumStatus)
                        ? msg : rec.CustomerIDBusregnumTinumStatus + " | " + msg;
            }
            else if (namesConfirmSame && matchedViaFuzzy)
            {
                var nameList = grp.Where(r => r.Businessname != null && !string.IsNullOrWhiteSpace(r.Businessname.Data))
                    .Select(r => NormReg(r.Businessname.Data)).Distinct();
                AddFuzzyWarning(grp, $"TIN {NormReg(grp.First().Tinum?.Data)}: BUSINESS NAME VARIES ACROSS RECORDS ({string.Join(", ", nameList)}) — TREATED AS THE SAME BUSINESS (FUZZY MATCH)");
            }
        }

        return list;
    }
    List<IndividualContext> DuplicateUser_CustomerIDAndDateOfBirth(List<IndividualContext> _fromExcelFile)
    {
        if (_fromExcelFile == null)
            throw new ArgumentNullException(nameof(_fromExcelFile));

        // 1) Group by normalized CustomerID + NatIDNum
        var groups = _fromExcelFile
            .GroupBy(r => new
            {
                Customer = NormalizeCustomerId(r.CustomerID?.Data),
                Nat = (r.NatIDNum?.Data ?? "").Trim()
            });

        // 2) Identify groups with mismatched DOBs using normalized dates
        var keysWithMismatchedDob = new HashSet<(string, string)>();

        foreach (var group in groups)
        {
            var distinctDobs = new HashSet<string>();
            bool hasMismatch = false;

            foreach (var record in group)
            {
                string dob = NormalizeDate(record.DateOfBirth?.Data);

                if (!distinctDobs.Add(dob))
                    continue;  // Skip if we've already seen this exact DOB

                if (distinctDobs.Count > 1)
                {
                    hasMismatch = true;
                    break;  // No need to check further once we find 2 distinct DOBs
                }
            }

            if (hasMismatch)
            {
                keysWithMismatchedDob.Add((group.Key.Customer, group.Key.Nat));
            }
        }

        // 3) Mark affected records
        foreach (var rec in _fromExcelFile)
        {
            var key = (
                NormalizeCustomerId(rec.CustomerID?.Data),
                (rec.NatIDNum?.Data ?? "").Trim()
            );

            if (keysWithMismatchedDob.Contains(key))
            {
                rec.CusumerIDDateOfBirth = "E";
            }
        }
        var b = _fromExcelFile;

        return _fromExcelFile;
    }

    // ── Issue #12 — Same ID value: DOB + token name check (Sprint 11) ─────────
    // An ID value shared across different CustomerIDs is acceptable ONLY if
    // DOB and name (≥2 of 3 tokens) match across all records.
    // Also validates NatID/GhanaCard format.
    List<IndividualContext> CheckSamePersonalIDDifferentCustomer(List<IndividualContext> list)
    {
        if (list == null) throw new ArgumentNullException(nameof(list));

        // ── GhanaCard / NatID format check ───────────────────────────────────
        foreach (var rec in list)
        {
            var natId = rec.NatIDNum?.Data ?? string.Empty;
            if (!string.IsNullOrWhiteSpace(natId) && !IsValidNatIDFormat(natId))
                rec.NatIDFormatInvalid = "E";
        }

        // ── Cross-record ID conflict check ────────────────────────────────────
        var byIDValue = new Dictionary<string, List<(string CustID, string Field, IndividualContext Rec)>>();

        var idSelectors = new List<(string FieldName, Func<IndividualContext, string?> GetValue)>
        {
            ("NatIDNum",    r => r.NatIDNum?.Data),
            ("VotersIDNum", r => r.VotersIDNum?.Data),
            ("DriverLicNum",r => r.DriverLicNum?.Data),
            ("PassportNum", r => r.PassportNum?.Data),
            ("SSNum",       r => r.SSNum?.Data),
            ("EzwichNum",   r => r.EzwichNum?.Data),
            ("OtherIDNum",  r => r.OtherIDNum?.Data),
        };

        foreach (var rec in list)
        {
            var custId = NormalizeCustomerId(rec.CustomerID?.Data);
            if (string.IsNullOrWhiteSpace(custId)) continue;
            foreach (var (fieldName, getValue) in idSelectors)
            {
                var value = getValue(rec);
                if (!IsValidIDValue(value)) continue;
                var key = value!.Trim().ToUpperInvariant();
                if (!byIDValue.TryGetValue(key, out var bucket))
                { bucket = new List<(string, string, IndividualContext)>(); byIDValue[key] = bucket; }
                bucket.Add((custId, fieldName, rec));
            }
        }

        foreach (var kvp in byIDValue)
        {
            var entries = kvp.Value;
            var distinctCusts = entries.Select(e => e.CustID).Distinct().Count();
            if (distinctCusts < 2) continue;

            var fieldSummary = string.Join("|", entries.Select(e => e.Field).Distinct().OrderBy(f => f));

            // Get one representative record per distinct CustomerID for comparison
            var custGroups = entries
                .GroupBy(e => e.CustID)
                .Select(g => g.First().Rec)
                .ToList();

            var first    = custGroups[0];
            var firstDob = (first.DateOfBirth?.Data ?? string.Empty).Trim();

            // Step 1: DOB check
            bool dobConflict = custGroups.Skip(1).Any(other =>
            {
                var dob = (other.DateOfBirth?.Data ?? string.Empty).Trim();
                return !string.IsNullOrWhiteSpace(firstDob) &&
                       !string.IsNullOrWhiteSpace(dob) &&
                       dob != firstDob;
            });

            if (dobConflict)
            {
                foreach (var e in entries)
                    e.Rec.SamePersonalIDDifferentCustomer = $"E:DOB:{fieldSummary}";
                continue;
            }

            // Tiebreaker: same DOB + same canonical name across all CustomerIDs → same person / possible misspelling
            bool samePerson = false;
            bool possibleMisspelling = false;
            if (custGroups.Count > 1)
            {
                samePerson = true;

                foreach (var other in custGroups.Skip(1))
            {
                    var otherDob = (other.DateOfBirth?.Data ?? string.Empty).Trim();
                    bool dobMatch = !string.IsNullOrWhiteSpace(firstDob) && firstDob == otherDob;
                    if (!dobMatch)
                    {
                        samePerson = false;
                        possibleMisspelling = false;
                        break;
                    }

                    var nameMatch = GetNameMatchLevel(
                        first.Surname?.Data ?? string.Empty, first.FirstName?.Data ?? string.Empty,
                        other.Surname?.Data ?? string.Empty, other.FirstName?.Data ?? string.Empty);

                    if (nameMatch == NameMatchLevel.Full)
                        continue;

                    if (nameMatch == NameMatchLevel.Partial)
                    {
                        samePerson = false;
                        possibleMisspelling = true;
                        continue;
                    }

                    samePerson = false;
                    possibleMisspelling = false;
                    break;
                }
            }

            string flag;
            if (samePerson)
                flag = $"W:{fieldSummary}";
            else if (possibleMisspelling)
                flag = $"P:{fieldSummary}";
            else
                flag = $"E:{fieldSummary}";

            foreach (var entry in entries)
                entry.Rec.SamePersonalIDDifferentCustomer = flag;
        }

        return list;
    }

    // ── Issue #14 ─────────────────────────────────────────────────────────────
    // Same CustomerID linked to more than one distinct name cluster across records.
    // Name cluster = normalised Surname + FirstName (trimmed, uppercased).
    // ── CurBal parser ─────────────────────────────────────────────────────────
    // Returns null if blank, non-numeric, or a known placeholder.
    // Used by duplicate resolution to pick the record with the lowest balance.
    decimal? ParseCurBal(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return null;
        var cleaned = raw.Trim().Replace(",", "");
        if (decimal.TryParse(cleaned, out decimal val)) return val;
        return null;
    }

    // ── ID value quality filter ───────────────────────────────────────────────
    // Returns false for values that are too short, all-same-digit, or known
    // placeholders — these would cause false-positive cross-column ID conflicts.
    static readonly HashSet<string> _idPlaceholders = new(StringComparer.OrdinalIgnoreCase)
        { "N/A", "NA", "NONE", "NULL", "NIL", "0", "00000", "-", "NIL", "UNKNOWN", "NOTAPPLICABLE" };

    bool IsValidIDValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return false;
        var v = value.Trim();
        if (v.Length < 5) return false;
        if (_idPlaceholders.Contains(v)) return false;
        // All-same-character check (e.g. "0000000", "9999999", "XXXXXXX")
        if (v.Distinct().Count() == 1) return false;
        // Purely alphabetic values (no digit at all) -- e.g. "STAFF",
        // "GHANACARD", "STUDENT" -- are category labels, not real ID
        // numbers. A real ID always contains at least one digit. These get
        // entered surprisingly often (usually meaning "the real ID for this
        // person is a staff/Ghana Card/student ID", not literally the word
        // itself), and since many unrelated people can coincidentally have
        // the exact same label in the same column, using it as a
        // cross-record matching key produces false "same ID, different
        // person" conflicts between genuinely unrelated individuals.
        if (!v.Any(char.IsDigit)) return false;
        return true;
    }

    // ── Name normalisation helper ─────────────────────────────────────────────
    // Strips all non-letter characters (hyphens, apostrophes, spaces, periods),
    // uppercases, then sorts tokens alphabetically before joining.
    // This means:
    //   "ADAMU ABDUL-KADIR"  → "ABDULKADIRADAMU"
    //   "ADAMU ABDULKADIR"   → "ABDULKADIRADAMU"  ✓ same
    //   "ADAMU ABDUL KADIR"  → "ABDULKADIRADAMU"  ✓ same
    //   "ADAMU ABDULKADIR MOHAMMED" → "ABDULKADIRAADAMUMOHAMMED" — superset
    // For superset check: shorter canonical is fully contained in longer one.
    // ── Token-based name match (Sprint 11) ───────────────────────────────────
    // Extracts all letter tokens from all three name fields combined,
    // then counts how many tokens the two name sets share exactly.
    // Rule: if max tokens across both sides >= 3, need >= 2 matches.
    //       if max tokens across both sides <= 2, need >= 1 match.
    // Returns (matchCount, maxTokens, isSamePerson)
    (int matches, int maxTokens, bool isSame, bool matchedViaFormatting) CompareNameTokens(
        string surname1, string firstName1, string middle1,
        string surname2, string firstName2, string middle2)
    {
        // Two tokenisation strategies per name:
        //  - "split": hyphen/apostrophe/comma treated as token separators
        //             (original behaviour) -- "Nyarko-Opoku" -> {NYARKO, OPOKU}
        //  - "joined": those same characters treated as internal punctuation,
        //             stripped but NOT splitting -- "Nyarko-Opoku" -> {NYARKOOPOKU}
        // A hyphen/apostrophe/comma present in one submission and simply
        // omitted in another is a common formatting inconsistency, not a
        // different name. For names with none of those characters at all,
        // split == joined, so this never weakens a genuine mismatch check.
        HashSet<string> TokeniseSplit(string s, string f, string m)
        {
            var raw = $"{s} {f} {m}".ToUpperInvariant();
            return raw.Split(new[] { ' ', '-', '\'', '.', ',' },
                             StringSplitOptions.RemoveEmptyEntries)
                      .Select(t => new string(t.Where(char.IsLetter).ToArray()))
                      .Where(t => t.Length > 0)
                      .ToHashSet();
        }
        HashSet<string> TokeniseJoined(string s, string f, string m)
        {
            var raw = $"{s} {f} {m}".ToUpperInvariant();
            return raw.Split(new[] { ' ', '.' },
                             StringSplitOptions.RemoveEmptyEntries)
                      .Select(t => new string(t.Where(char.IsLetter).ToArray()))
                      .Where(t => t.Length > 0)
                      .ToHashSet();
        }

        var split1 = TokeniseSplit(surname1, firstName1, middle1);
        var split2 = TokeniseSplit(surname2, firstName2, middle2);
        var joined1 = TokeniseJoined(surname1, firstName1, middle1);
        var joined2 = TokeniseJoined(surname2, firstName2, middle2);

        (int matches, int maxTokens) Score(HashSet<string> a, HashSet<string> b)
            => (a.Count(t => b.Contains(t)), Math.Max(a.Count, b.Count));

        bool IsSame(int matches, int maxTokens) => maxTokens >= 3 ? matches >= 2 : matches >= 1;

        var rawScore = Score(split1, split2);
        bool isSameRaw = IsSame(rawScore.matches, rawScore.maxTokens);

        var best = new[] { rawScore, Score(split1, joined2), Score(joined1, split2), Score(joined1, joined2) }
            .OrderByDescending(c => c.matches)
            .First();
        bool isSameBest = IsSame(best.matches, best.maxTokens);

        // Only resolved once hyphen/apostrophe/comma formatting is accounted
        // for -- the raw, as-submitted comparison alone would have failed.
        bool matchedViaFormatting = !isSameRaw && isSameBest;

        return (best.matches, best.maxTokens, isSameBest, matchedViaFormatting);
    }

    // ── GhanaCard / NatID format validator (Sprint 11) ───────────────────────
    // Valid format: 3-letter country prefix + exactly 10 alphanumeric characters
    // Supported prefixes: GHA, NGA, CIV (expandable)
    static readonly HashSet<string> _natIDPrefixes =
        new(StringComparer.OrdinalIgnoreCase) { "GHA", "NGA", "CIV" };

    bool IsValidNatIDFormat(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return true; // blank is handled elsewhere
        var v = value.Trim().ToUpperInvariant();
        // Strip common separators (GHA-7151264541 or GHA7151264541)
        var clean = v.Replace("-", "").Replace(" ", "");
        if (clean.Length != 13) return false;
        var prefix = clean.Substring(0, 3);
        var digits = clean.Substring(3);
        return _natIDPrefixes.Contains(prefix) && digits.All(char.IsLetterOrDigit);
    }
    // Returns letters-only uppercase string for exact/subset matching.
    // "ADAMU ABDUL-KADIR" → "ADAMUABDULKADIR"
    string NormaliseNameForComparison(string surname, string firstName)
    {
        var raw = $"{surname} {firstName}".ToUpperInvariant();
        return new string(raw.Where(char.IsLetter).ToArray());
    }

    string[] NormaliseNameTokens(string surname, string firstName)
    {
        var raw = $"{surname} {firstName}".ToUpperInvariant();
        return raw.Split(new[] { ' ', '-', '\'', '.', ',' }, StringSplitOptions.RemoveEmptyEntries)
                  .Select(t => new string(t.Where(char.IsLetter).ToArray()))
                  .Where(t => t.Length > 0)
                  .ToArray();
    }

    // Returns sorted-token canonical for reordering detection.
    // "ASIEDU ASARE" and "ASARE ASIEDU" both → "ASAREASIEDU" after sort
    string NormaliseNameSortedTokens(string surname, string firstName)
    {
        var tokens = NormaliseNameTokens(surname, firstName)
                        .OrderBy(t => t);
        return string.Concat(tokens);
    }

    // Returns true if two canonical (letters-only) names match:
    // 1. Exact match
    // 2. Subset — shorter contained in longer (dropped middle name)
    bool IsSameName(string canon1, string canon2)
    {
        if (string.IsNullOrWhiteSpace(canon1) || string.IsNullOrWhiteSpace(canon2)) return false;
        if (canon1 == canon2) return true;
        if (canon2.Contains(canon1) || canon1.Contains(canon2)) return true;
        return false;
    }

    // Full name comparison using both letters-only AND sorted-token methods.
    // Catches: hyphen/space variants, dropped middle names, AND reordered names.
    // "ASIEDU ASARE" vs "ASARE ASIEDU" → sorted tokens both = "ASAREASIEDU" → true
    bool IsSameNameFull(string surname1, string firstName1, string surname2, string firstName2)
    {
        var canon1  = NormaliseNameForComparison(surname1, firstName1);
        var canon2  = NormaliseNameForComparison(surname2, firstName2);
        if (IsSameName(canon1, canon2)) return true;

        var sorted1 = NormaliseNameSortedTokens(surname1, firstName1);
        var sorted2 = NormaliseNameSortedTokens(surname2, firstName2);
        if (sorted1.Length > 0 && sorted2.Length > 0)
        {
            if (sorted1 == sorted2) return true;
            if (sorted2.Contains(sorted1) || sorted1.Contains(sorted2)) return true;
        }
        return false;
    }

    enum NameMatchLevel
    {
        None,
        Partial,
        Full
    }

    NameMatchLevel GetNameMatchLevel(string surname1, string firstName1, string surname2, string firstName2)
    {
        var tokens1 = NormaliseNameTokens(surname1, firstName1);
        var tokens2 = NormaliseNameTokens(surname2, firstName2);
        if (tokens1.Length == 0 || tokens2.Length == 0)
            return NameMatchLevel.None;

        if (IsSameNameFull(surname1, firstName1, surname2, firstName2))
            return NameMatchLevel.Full;

        var commonTokens = tokens1.Distinct(StringComparer.Ordinal)
                                 .Intersect(tokens2.Distinct(StringComparer.Ordinal))
                                 .Count();
        if (commonTokens >= 2)
            return NameMatchLevel.Partial;

        return NameMatchLevel.None;
    }

    // ── Issue #14 — Same CustomerID: DOB + name conflict detection ───────────
    // Same CustomerID linked to more than one distinct name cluster across records.
    // Uses canonical name comparison + DOB tiebreaker.
    // Rule: if canonical names differ BUT DOB matches → same person, no flag.
    //       if canonical names differ AND DOB differs  → genuine conflict, flag.
    // Step 1: DOBs differ → UNLOADABLE (SameCustomerIDDifferentDOB = "E")
    // Step 2: names differ by token rule → UNLOADABLE (SameCustomerIDDifferentName = "E")
    List<IndividualContext> CheckSameCustomerIDDifferentName(List<IndividualContext> list)
    {
        if (list == null) throw new ArgumentNullException(nameof(list));

        var groups = list
            .Where(r => !string.IsNullOrWhiteSpace(r.CustomerID?.Data))
            .GroupBy(r => NormalizeCustomerId(r.CustomerID!.Data));

        foreach (var grp in groups)
        {
            var records = grp.ToList();
            if (records.Count < 2) continue;

            var firstDob = (records[0].DateOfBirth?.Data ?? string.Empty).Trim();

            // Step 1: DOB check — any mismatch → flag all
            bool dobConflict = records.Skip(1).Any(r =>
            {
                var dob = (r.DateOfBirth?.Data ?? string.Empty).Trim();
                return !string.IsNullOrWhiteSpace(firstDob) &&
                       !string.IsNullOrWhiteSpace(dob) &&
                       dob != firstDob;
            });

            if (dobConflict)
            {
                foreach (var r in records) r.SameCustomerIDDifferentDOB = "E";
                continue;
            }

            // Step 2: Name token check
            bool nameConflict = false;
            bool misspell = false;
            for (int i = 0; i < records.Count && !nameConflict; i++)
            {
                for (int j = i + 1; j < records.Count && !nameConflict; j++)
                {
                    var a = records[i]; var b = records[j];
                    var (matches, maxTokens, isSame, _) = CompareNameTokens(
                        a.Surname?.Data ?? string.Empty,
                        a.FirstName?.Data ?? string.Empty,
                        a.MiddleNames?.Data ?? string.Empty,
                        b.Surname?.Data ?? string.Empty,
                        b.FirstName?.Data ?? string.Empty,
                        b.MiddleNames?.Data ?? string.Empty);

                    if (!isSame)
                    {
                        nameConflict = true;
                        misspell = matches > 0;
                    }
                }
            }

            if (nameConflict)
            {
                string flag = misspell ? "E:MISSPELL" : "E";
                foreach (var r in records) r.SameCustomerIDDifferentName = flag;
            }
        }

        return list;
    }

    // ── Issue #2 (name mismatch on same facility) ─────────────────────────────
    // Records that share AccNum + CustomerID but have different name clusters.
    // Uses canonical name comparison + DOB tiebreaker (same rules as #14).
    List<IndividualContext> CheckDuplicateNameMismatch(List<IndividualContext> list)
    {
        if (list == null) throw new ArgumentNullException(nameof(list));

        var groups = list
            .Where(r =>
                !string.IsNullOrWhiteSpace(r.CreditFacilityAccNum?.Data) &&
                !string.IsNullOrWhiteSpace(r.CustomerID?.Data))
            .GroupBy(r => (
                AccNum:     NormalizeAccountNumber(r.CreditFacilityAccNum!.Data),
                CustomerID: NormalizeCustomerId(r.CustomerID!.Data)
            ));

        foreach (var grp in groups)
        {
            var records = grp.ToList();
            bool hasConflict = false;

            for (int i = 0; i < records.Count; i++)
            {
                for (int j = i + 1; j < records.Count; j++)
                {
                    var a = records[i]; var b = records[j];
                    var tokensA = NormaliseNameTokens(
                        a.Surname?.Data ?? string.Empty, a.FirstName?.Data ?? string.Empty);
                    var tokensB = NormaliseNameTokens(
                        b.Surname?.Data ?? string.Empty, b.FirstName?.Data ?? string.Empty);
                    if (tokensA.Length == 0 || tokensB.Length == 0)
                        continue;

                    var nameMatch = GetNameMatchLevel(
                        a.Surname?.Data ?? string.Empty, a.FirstName?.Data ?? string.Empty,
                        b.Surname?.Data ?? string.Empty, b.FirstName?.Data ?? string.Empty);
                    if (nameMatch == NameMatchLevel.Full)
                        continue;

                    var dobA = (a.DateOfBirth?.Data ?? string.Empty).Trim();
                    var dobB = (b.DateOfBirth?.Data ?? string.Empty).Trim();
                    bool dobMatch = !string.IsNullOrWhiteSpace(dobA) &&
                                    !string.IsNullOrWhiteSpace(dobB) &&
                                    dobA == dobB;
                    if (!dobMatch || nameMatch == NameMatchLevel.Partial)
                    {
                        hasConflict = true;
                        break;
                    }
                }
                if (hasConflict) break;
            }

            if (hasConflict)
                foreach (var rec in records)
                    rec.DuplicateNameMismatch = "E";
        }

        return list;
    }

    // ── Single-pass cross-record check engine (Performance — Sprint 5) ────────
    // Replaces CheckSamePersonalIDDifferentCustomer + CheckSameCustomerIDDifferentName
    // + CheckDuplicateNameMismatch with ONE pass through the list to build all indexes,
    // then applies all checks against those indexes.
    // At 1M records: 4 separate GroupBy passes → 1 build pass + 4 index reads.
    List<IndividualContext> RunAllCrossRecordChecksIND(List<IndividualContext> list)
    {
        if (list == null) throw new ArgumentNullException(nameof(list));

        // ── Build all indexes in a single pass ────────────────────────────────
        // byCustomerID:   normalisedCustomerID → all records with that ID
        // byAccNumCustID: (normAccNum, normCustID) → all records for that facility+customer
        // byIDValue:      any ID value (across ALL 7 ID fields) → list of (customerID, fieldName, record)
        //                 Cross-column: same value in NatIDNum on rec A and VotersIDNum on rec B → flagged
        var byCustomerID   = new Dictionary<string, List<IndividualContext>>();
        var byAccNumCustID = new Dictionary<(string, string), List<IndividualContext>>();
        var byIDValue      = new Dictionary<string, List<(string CustID, string Field, IndividualContext Rec)>>();

        void AddTo<TKey>(Dictionary<TKey, List<IndividualContext>> dict, TKey key, IndividualContext rec)
            where TKey : notnull
        {
            if (!dict.TryGetValue(key, out var bucket)) { bucket = new List<IndividualContext>(); dict[key] = bucket; }
            bucket.Add(rec);
        }

        void IndexIDValue(string? value, string fieldName, string custID, IndividualContext rec)
        {
            if (!IsValidIDValue(value)) return;
            var key = value!.Trim().ToUpperInvariant();
            if (!byIDValue.TryGetValue(key, out var bucket))
            { bucket = new List<(string, string, IndividualContext)>(); byIDValue[key] = bucket; }
            bucket.Add((custID, fieldName, rec));
        }

        foreach (var rec in list)
        {
            var custId = NormalizeCustomerId(rec.CustomerID?.Data);
            var accNum = NormalizeAccountNumber(rec.CreditFacilityAccNum?.Data);

            if (!string.IsNullOrWhiteSpace(custId))
                AddTo(byCustomerID, custId, rec);

            if (!string.IsNullOrWhiteSpace(accNum) && !string.IsNullOrWhiteSpace(custId))
                AddTo(byAccNumCustID, (accNum, custId), rec);

            // Cross-column ID index — all 7 fields indexed by their VALUE
            IndexIDValue(rec.NatIDNum?.Data,     "NatIDNum",     custId, rec);
            IndexIDValue(rec.VotersIDNum?.Data,  "VotersIDNum",  custId, rec);
            IndexIDValue(rec.DriverLicNum?.Data, "DriverLicNum", custId, rec);
            IndexIDValue(rec.PassportNum?.Data,  "PassportNum",  custId, rec);
            IndexIDValue(rec.SSNum?.Data,        "SSNum",        custId, rec);
            IndexIDValue(rec.EzwichNum?.Data,    "EzwichNum",    custId, rec);
            IndexIDValue(rec.OtherIDNum?.Data,   "OtherIDNum",   custId, rec);
        }

        // ── #12: Same ID value → different CustomerIDs — DOB + token name check ──
        foreach (var kvp in byIDValue)
        {
            var entries = kvp.Value;
            var distinctCusts = entries
                .Where(e => !string.IsNullOrWhiteSpace(e.CustID))
                .Select(e => e.CustID).Distinct().Count();
            if (distinctCusts < 2) continue;

            var fieldSummary = string.Join("|", entries.Select(e => e.Field).Distinct().OrderBy(f => f));
            var custGroups   = entries.GroupBy(e => e.CustID).Select(g => g.First().Rec).ToList();
            var first12      = custGroups[0];
            var firstDob12   = (first12.DateOfBirth?.Data ?? string.Empty).Trim();

            // Step 1: DOB check
            bool dobConflict12 = custGroups.Skip(1).Any(o => {
                var d = (o.DateOfBirth?.Data ?? string.Empty).Trim();
                return !string.IsNullOrWhiteSpace(firstDob12) && !string.IsNullOrWhiteSpace(d) && d != firstDob12;
            });
            if (dobConflict12)
            {
                foreach (var e in entries) e.Rec.SamePersonalIDDifferentCustomer = $"E:DOB:{fieldSummary}";
                continue;
            }

            // Step 2: Token name check
            bool nameConflict12 = false; bool misspell12 = false; bool viaFormatting12 = false;
            for (int i = 0; i < custGroups.Count && !nameConflict12; i++)
                for (int j = i + 1; j < custGroups.Count && !nameConflict12; j++)
                {
                    var (matches12, _, isSame12, formatting12) = CompareNameTokens(
                        custGroups[i].Surname?.Data    ?? string.Empty,
                        custGroups[i].FirstName?.Data  ?? string.Empty,
                        custGroups[i].MiddleNames?.Data ?? string.Empty,
                        custGroups[j].Surname?.Data    ?? string.Empty,
                        custGroups[j].FirstName?.Data  ?? string.Empty,
                        custGroups[j].MiddleNames?.Data ?? string.Empty);
                    if (!isSame12) { nameConflict12 = true; misspell12 = matches12 > 0; }
                    else if (formatting12) { viaFormatting12 = true; }
                }

            string flag12 = nameConflict12
                ? (misspell12 ? $"E:MISSPELL:{fieldSummary}" : $"E:NAME:{fieldSummary}")
                : (viaFormatting12 ? $"W:FORMATTING:{fieldSummary}" : $"W:{fieldSummary}");
            foreach (var entry in entries)
                entry.Rec.SamePersonalIDDifferentCustomer = flag12;
        }

        // ── #14: Same CustomerID — DOB check then token name check ─────────────
        foreach (var grp in byCustomerID.Values)
        {
            var records = grp.ToList();
            if (records.Count < 2) continue;

            var firstDob = (records[0].DateOfBirth?.Data ?? string.Empty).Trim();
            bool dobConflict = records.Skip(1).Any(r => {
                var d = (r.DateOfBirth?.Data ?? string.Empty).Trim();
                return !string.IsNullOrWhiteSpace(firstDob) && !string.IsNullOrWhiteSpace(d) && d != firstDob;
            });
            if (dobConflict)
            {
                foreach (var r in records) r.SameCustomerIDDifferentDOB = "E";
                continue;
            }

            bool nameConflict = false; bool misspellBlocking = false; bool misspellWarning = false; bool misspellFormatting = false;
            for (int i = 0; i < records.Count && !nameConflict; i++)
                for (int j = i + 1; j < records.Count && !nameConflict; j++)
                {
                    var (matches, maxTokens, isSame, viaFormatting) = CompareNameTokens(
                        records[i].Surname?.Data ?? string.Empty,
                        records[i].FirstName?.Data ?? string.Empty,
                        records[i].MiddleNames?.Data ?? string.Empty,
                        records[j].Surname?.Data ?? string.Empty,
                        records[j].FirstName?.Data ?? string.Empty,
                        records[j].MiddleNames?.Data ?? string.Empty);
                    if (!isSame)
                    {
                        // Low confidence: one token or none in common -- still a
                        // blocking conflict, same as before.
                        nameConflict = true;
                        misspellBlocking = matches > 0;
                    }
                    else if (viaFormatting)
                    {
                        // Only resolved to a match once hyphen/apostrophe/comma
                        // formatting was accounted for -- e.g. "Nyarko-Opoku"
                        // vs "Nyarkoopoku". Not a mismatch, but worth a distinct
                        // note rather than the generic misspelling warning.
                        misspellFormatting = true;
                    }
                    else if (matches < maxTokens)
                    {
                        // High confidence it's the same person (enough tokens
                        // matched to pass), but not a perfect match -- one token
                        // differs, e.g. "KOFL" vs "KOFI". Worth flagging so it
                        // doesn't pass through completely silently, but not
                        // worth blocking over.
                        misspellWarning = true;
                    }
                }

            if (nameConflict)
            {
                var conflictingNames = records
                    .Select(r => $"{(r.Surname?.Data ?? string.Empty)} {(r.FirstName?.Data ?? string.Empty)}".Trim())
                    .Where(n => !string.IsNullOrWhiteSpace(n))
                    .Distinct()
                    .ToList();
                var namesJoined = string.Join(", ", conflictingNames);
                var custIdDisplay = (records[0].CustomerID?.Data ?? string.Empty).Trim();
                string flagCode = misspellBlocking ? "E:MISSPELL" : "E";
                string flag = $"{flagCode}||{custIdDisplay}||{namesJoined}";
                foreach (var r in records) r.SameCustomerIDDifferentName = flag;
            }
            else if (misspellFormatting)
            {
                foreach (var r in records) r.SameCustomerIDDifferentName = "W:FORMATTING";
            }
            else if (misspellWarning)
            {
                foreach (var r in records) r.SameCustomerIDDifferentName = "W:MISSPELL";
            }
        }

        // ── #15: Same CustomerID — different GHA (Ghana Card) numbers ──────────
        // GHA Card numbers are meant to uniquely identify one person nationally,
        // so if the same CustomerID has two different GHA-format ID values on
        // file -- regardless of which of the 7 ID columns each is filed under --
        // that's a genuine identity conflict, not just a formatting quirk.
        // Restricted to GHA specifically (not other 3-letter country prefixes
        // like NGA/CIV) since only the Ghana Card carries that uniqueness
        // guarantee here.
        static bool IsGhanaCardNumber(string? value, out string normalised)
        {
            normalised = string.Empty;
            if (string.IsNullOrWhiteSpace(value)) return false;
            var cleaned = System.Text.RegularExpressions.Regex.Replace(value, @"[ \/,_-]", "").ToUpperInvariant();
            if (cleaned.Length != 13) return false;
            if (!cleaned.Substring(0, 3).Equals("GHA", StringComparison.Ordinal)) return false;
            if (!cleaned.Substring(3).All(char.IsDigit)) return false;
            normalised = cleaned;
            return true;
        }

        foreach (var grp in byCustomerID.Values)
        {
            var records = grp.ToList();
            if (records.Count < 2) continue;

            // (fieldName, ghaValue, record) for every GHA-format ID across all 7 ID columns
            var ghaEntries = new List<(string Field, string Value, IndividualContext Rec)>();
            foreach (var r in records)
            {
                void CheckGhaField(string? val, string fieldName)
                {
                    if (IsGhanaCardNumber(val, out var norm))
                        ghaEntries.Add((fieldName, norm, r));
                }
                CheckGhaField(r.NatIDNum?.Data, "NatIDNum");
                CheckGhaField(r.VotersIDNum?.Data, "VotersIDNum");
                CheckGhaField(r.DriverLicNum?.Data, "DriverLicNum");
                CheckGhaField(r.PassportNum?.Data, "PassportNum");
                CheckGhaField(r.SSNum?.Data, "SSNum");
                CheckGhaField(r.EzwichNum?.Data, "EzwichNum");
                CheckGhaField(r.OtherIDNum?.Data, "OtherIDNum");
            }

            var distinctGhaValues = ghaEntries.Select(e => e.Value).Distinct().ToList();
            if (distinctGhaValues.Count > 1)
            {
                foreach (var r in records)
                {
                    var ownFields = ghaEntries.Where(e => e.Rec == r).Select(e => e.Field).Distinct();
                    r.SameCustomerIDDifferentGhanaCard = "E:" + string.Join(",", ownFields);
                }
            }
        }

        // ── #2: Same AccNum+CustomerID → different name clusters ──────────────
        foreach (var grp in byAccNumCustID.Values)
        {
            var records = grp.ToList();
            bool hasConflict = false;
            for (int i = 0; i < records.Count && !hasConflict; i++)
            {
                for (int j = i + 1; j < records.Count && !hasConflict; j++)
                {
                    var a = records[i]; var b = records[j];
                    var canonA = NormaliseNameForComparison(
                        a.Surname?.Data ?? string.Empty, a.FirstName?.Data ?? string.Empty);
                    var canonB = NormaliseNameForComparison(
                        b.Surname?.Data ?? string.Empty, b.FirstName?.Data ?? string.Empty);
                    if (string.IsNullOrWhiteSpace(canonA) || string.IsNullOrWhiteSpace(canonB)) continue;
                    if (!IsSameName(canonA, canonB))
                    {
                        var dobA = (a.DateOfBirth?.Data ?? string.Empty).Trim();
                        var dobB = (b.DateOfBirth?.Data ?? string.Empty).Trim();
                        bool dobMatch = !string.IsNullOrWhiteSpace(dobA) &&
                                        !string.IsNullOrWhiteSpace(dobB) && dobA == dobB;
                        if (!dobMatch) hasConflict = true;
                    }
                }
            }
            if (hasConflict)
                foreach (var r in records) r.DuplicateNameMismatch = "E";
        }

        return list;
    }

    string NormalizeDate(string dob)
    {
        if (string.IsNullOrWhiteSpace(dob))
            return string.Empty;

        string normalized = dob.Trim();

        // Attempt to parse and standardize date format
        if (DateTime.TryParse(normalized, out DateTime date))
        {
            return date.ToString("yyyy-MM-dd");
        }

        return normalized;
    }
    string NormalizeCustomerId(string? value)
    {
        // Used ONLY for matching/key-building (matcher dictionaries, cross-record
        // checks) so that "001238" and "1238" are treated as the same real-world
        // customer when comparing against history. NEVER assign the result of
        // this back onto a CellDataAndStatus.Data that will be written to output
        // or saved to the reference DB -- use CleanCustomerIdForOutput for that.
        var normalized = RemoveAllWhitespace(value).ToUpperInvariant();
        if (normalized.All(char.IsDigit))
        {
            normalized = normalized.TrimStart('0');
        }
        if (string.IsNullOrEmpty(normalized) && !string.IsNullOrWhiteSpace(value) && RemoveAllWhitespace(value).All(char.IsDigit))
        {
            return "0";
        }
        return normalized;
    }
    string CleanCustomerIdForOutput(string? value)
    {
        // What actually gets written to CLEAN output and saved to the reference
        // DB. Strips stray whitespace and normalizes case, same as
        // NormalizeCustomerId, but deliberately does NOT strip leading zeros --
        // "001238" is a real, meaningful value (e.g. it's what the subscriber
        // institution's own system uses), and stripping it here previously
        // caused a correctly-submitted customer to look like a brand new one
        // downstream.
        return RemoveAllWhitespace(value).ToUpperInvariant();
    }
    string NormalizeAccountNumber(string? value)
    {
        return RemoveAllWhitespace(value).ToUpperInvariant();
    }
    string RemoveAllWhitespace(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }
        return new string(value.Where(c => !char.IsWhiteSpace(c)).ToArray());
    }
    bool HasInternalWhitespace(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }
        var trimmed = value.Trim();
        return trimmed.Any(char.IsWhiteSpace);
    }
    bool LooksLikeExponentNotation(string? value)
    {
        var normalized = RemoveAllWhitespace(value);
        if (string.IsNullOrWhiteSpace(normalized))
        {
            return false;
        }
        return System.Text.RegularExpressions.Regex.IsMatch(normalized, @"^[+-]?\d+(\.\d+)?[eE][+-]?\d+$");
    }
    void AddCellError(CellDataAndStatus? cell, string error)
    {
        if (cell == null)
        {
            return;
        }
        cell.Passed = false;
        cell.Errors ??= new List<string>();
        if (!cell.Errors.Contains(error))
        {
            cell.Errors.Add(error);
        }
    }
    void NormalizeAccountAndCustomerFields(CellDataAndStatus? account, CellDataAndStatus? customer, string accountLabel)
    {
        if (account != null)
        {
            if (string.IsNullOrWhiteSpace(account.Data))
            {
                AddCellError(account, $"{accountLabel}: MISSING FACILITY ACCOUNT NUMBER");
            }
            else if (LooksLikeExponentNotation(account.Data))
            {
                AddCellError(account, $"{accountLabel}: INVALID ACCOUNT NUMBER - EXPONENTIATED VALUE DETECTED");
            }
            else
            {
                if (HasInternalWhitespace(account.Data))
                {
                    account.Data = NormalizeAccountNumber(account.Data);
                }
                else
                {
                    account.Data = account.Data?.Trim();
                }
            }
        }

        if (customer != null)
        {
            if (LooksLikeExponentNotation(customer.Data))
            {
                AddCellError(customer, "CUSTOMERID: INVALID CUSTOMER ID - EXPONENTIATED VALUE DETECTED");
            }
            else
            {
                customer.Data = CleanCustomerIdForOutput(customer.Data);
            }
        }

        if (account != null && customer != null &&
            !string.IsNullOrWhiteSpace(account.Data) &&
            !string.IsNullOrWhiteSpace(customer.Data) &&
            NormalizeAccountNumber(account.Data) == NormalizeCustomerId(customer.Data))
        {
            AddCellError(account, $"{accountLabel}: FACILITY ACCOUNT NUMBER CANNOT BE THE SAME AS CUSTOMERID");
            AddCellError(customer, "CUSTOMERID: CUSTOMERID CANNOT BE THE SAME AS FACILITY ACCOUNT NUMBER");
        }
    }

    // ── Closed-facility routing ──────────────────────────────────────────────
    // A facility already reported closed in a prior submission, reappearing
    // with the same status, is redundant information for the destination
    // system -- diverted to its own CLOSED sheet instead of CLEAN. Matched on
    // the same (FacilityAccNum, CustomerID, DisbursementDate) key used
    // everywhere else for reference matching. Only diverted when there's no
    // discrepancy on the identity fields too (DOB/names for IND,
    // Businessname/Busregnum for BUS) -- if those disagree, something's
    // actually wrong and it should fall through to normal handling instead of
    // being silently filed away as "just a closed repeat."
    // "C", "P", and "T" are all closed statuses (see the existing precedent at
    // the FacilityStatusCode checks elsewhere in this file) -- not just "C".
    bool IsClosedFacilityStatus(string? code)
    {
        var c = (code ?? string.Empty).Trim();
        return string.Equals(c, "C", StringComparison.OrdinalIgnoreCase)
            || string.Equals(c, "P", StringComparison.OrdinalIgnoreCase)
            || string.Equals(c, "T", StringComparison.OrdinalIgnoreCase);
    }

    List<IndividualContext> ExtractClosedFacilitiesInd(List<IndividualContext> cleanCandidates, List<IndividualRef> fromDatabase)
    {
        var closed = new List<IndividualContext>();
        if (cleanCandidates == null || cleanCandidates.Count == 0) return closed;

        var refIndex = new Dictionary<(string, string, string), IndividualRef>();
        foreach (var r in fromDatabase)
        {
            var k = (NormalizeAccountNumber(r.CreditFacilityAccNum), NormalizeCustomerId(r.CustomerID), (r.DisbursementDate ?? string.Empty).Trim());
            refIndex[k] = r; // last-write-wins is fine here; an exact 3-part match should be unique in practice
        }

        foreach (var record in cleanCandidates)
        {
            var key = (NormalizeAccountNumber(record.CreditFacilityAccNum?.Data),
                       NormalizeCustomerId(record.CustomerID?.Data),
                       (record.DisbursementDate?.Data ?? string.Empty).Trim());

            if (!refIndex.TryGetValue(key, out var refRow)) continue;

            bool refClosed = IsClosedFacilityStatus(refRow.FacilityStatusCode);
            bool incomingClosed = IsClosedFacilityStatus(record.FacilityStatusCode?.Data);
            if (!refClosed || !incomingClosed) continue;

            bool dobMatches = string.IsNullOrWhiteSpace(refRow.DateOfBirth) ||
                string.Equals(refRow.DateOfBirth.Trim(), (record.DateOfBirth?.Data ?? string.Empty).Trim(), StringComparison.OrdinalIgnoreCase);
            bool nameMatches =
                (string.IsNullOrWhiteSpace(refRow.Surname) || string.Equals(refRow.Surname.Trim(), (record.Surname?.Data ?? string.Empty).Trim(), StringComparison.OrdinalIgnoreCase)) &&
                (string.IsNullOrWhiteSpace(refRow.FirstName) || string.Equals(refRow.FirstName.Trim(), (record.FirstName?.Data ?? string.Empty).Trim(), StringComparison.OrdinalIgnoreCase)) &&
                (string.IsNullOrWhiteSpace(refRow.MiddleNames) || string.Equals(refRow.MiddleNames.Trim(), (record.MiddleNames?.Data ?? string.Empty).Trim(), StringComparison.OrdinalIgnoreCase));

            if (dobMatches && nameMatches)
            {
                closed.Add(record);
            }
        }
        return closed;
    }

    List<BusinessContext> ExtractClosedFacilitiesBus(List<BusinessContext> cleanCandidates, List<BusinessRef> fromDatabase)
    {
        var closed = new List<BusinessContext>();
        if (cleanCandidates == null || cleanCandidates.Count == 0) return closed;

        var refIndex = new Dictionary<(string, string, string), BusinessRef>();
        foreach (var r in fromDatabase)
        {
            var k = (NormalizeAccountNumber(r.CreditFacilityAccNum), NormalizeCustomerId(r.CustomerID), (r.DisbursementDate ?? string.Empty).Trim());
            refIndex[k] = r;
        }

        foreach (var record in cleanCandidates)
        {
            var key = (NormalizeAccountNumber(record.Facilityaccnum?.Data),
                       NormalizeCustomerId(record.CustomerID?.Data),
                       (record.DisbursementDate?.Data ?? string.Empty).Trim());

            if (!refIndex.TryGetValue(key, out var refRow)) continue;

            bool refClosed = IsClosedFacilityStatus(refRow.FacilityStatusCode);
            bool incomingClosed = IsClosedFacilityStatus(record.FacilityStatusCode?.Data);
            if (!refClosed || !incomingClosed) continue;

            // Business has no DOB/name equivalent to double-check against -- Businessname
            // and Busregnum are the closest identity fields available.
            bool nameMatches = string.IsNullOrWhiteSpace(refRow.Businessname) ||
                string.Equals(refRow.Businessname.Trim(), (record.Businessname?.Data ?? string.Empty).Trim(), StringComparison.OrdinalIgnoreCase);
            bool regNumMatches = string.IsNullOrWhiteSpace(refRow.Busregnum) ||
                string.Equals(refRow.Busregnum.Trim(), (record.Busregnum?.Data ?? string.Empty).Trim(), StringComparison.OrdinalIgnoreCase);

            if (nameMatches && regNumMatches)
            {
                closed.Add(record);
            }
        }
        return closed;
    }

    // ── Phase 4: unify reference + incoming for cross-record checks ─────────
    // The existing cross-record checks (RunAllCrossRecordChecksIND — DOB/name
    // conflict, GHA card conflict) only ever compared records WITHIN the same
    // uploaded file. A submission that matched what's stored in reference was
    // silently trusted, with no check that it actually agreed with reference
    // on name or ID -- only DOB and disbursement date got compared against
    // history (via the matcher itself), name and ID did not.
    //
    // Rather than duplicating comparison logic, reference is folded in as
    // "virtual" records -- one synthetic IndividualContext per CustomerID
    // present in this file, built from whichever reference row for that
    // customer was most recently updated. Injected into the same list that
    // RunAllCrossRecordChecksIND already processes, the existing grouping-by-
    // CustomerID logic naturally compares a real incoming record against its
    // own reference history the same way it already compares two records
    // within one file. The caller must remove these synthetic records again
    // afterward (via the returned marker set) -- they must never reach
    // output, DB save, or counts.
    List<IndividualContext> BuildReferenceVirtualRecordsInd(List<IndividualContext> incoming, List<IndividualRef> fromDatabase, out Dictionary<string, string> previousNameByCustomer, out Dictionary<string, string> previousDOBByCustomer, out Dictionary<string, string> previousDOBReportingPeriodByCustomer)
    {
        var virtualRecords = new List<IndividualContext>();
        previousNameByCustomer = new Dictionary<string, string>();
        previousDOBByCustomer = new Dictionary<string, string>();
        previousDOBReportingPeriodByCustomer = new Dictionary<string, string>();
        if (incoming == null || incoming.Count == 0 || fromDatabase == null || fromDatabase.Count == 0)
            return virtualRecords;

        var customerKeys = incoming
            .Select(r => NormalizeCustomerId(r.CustomerID?.Data))
            .Where(k => !string.IsNullOrWhiteSpace(k))
            .ToHashSet();

        var refByCustomer = fromDatabase
            .Where(r => customerKeys.Contains(NormalizeCustomerId(r.CustomerID)))
            .GroupBy(r => NormalizeCustomerId(r.CustomerID));

        foreach (var group in refByCustomer)
        {
            // Most recently updated row for this customer represents what we
            // currently trust as their identity.
            var canonical = group.OrderByDescending(r => r.LastUpdatedDate).First();

            CellDataAndStatus Cell(string? v)
            {
                var value = v ?? string.Empty;
                return new CellDataAndStatus(value) { Data = value };
            }

            virtualRecords.Add(new IndividualContext
            {
                CustomerID           = Cell(canonical.CustomerID),
                CreditFacilityAccNum = Cell(canonical.CreditFacilityAccNum),
                DateOfBirth          = Cell(canonical.DateOfBirth),
                Surname              = Cell(canonical.Surname),
                FirstName            = Cell(canonical.FirstName),
                MiddleNames          = Cell(canonical.MiddleNames),
                NatIDNum             = Cell(canonical.NatIDNum),
                VotersIDNum          = Cell(canonical.VotersIDNum),
                DriverLicNum         = Cell(canonical.DriverLicNum),
                PassportNum          = Cell(canonical.PassportNum),
                SSNum                = Cell(canonical.SSNum),
                EzwichNum            = Cell(canonical.EzwichNum),
                OtherIDNum           = Cell(canonical.OtherIDNum),
            });

            // Readable "what's on file" name, natural word order -- for display
            // in a misspelling warning/error, not for comparison (that's what
            // the virtual record + existing token-matching logic is for).
            var readableName = string.Join(" ", new[] { canonical.Surname, canonical.FirstName, canonical.MiddleNames }
                .Where(s => !string.IsNullOrWhiteSpace(s)));
            if (!string.IsNullOrWhiteSpace(readableName))
            {
                previousNameByCustomer[group.Key] = readableName.Trim();
            }

            // Same idea for DOB -- what's on file, plus which reporting period
            // it was last confirmed in, for display alongside a conflict message.
            if (!string.IsNullOrWhiteSpace(canonical.DateOfBirth))
            {
                previousDOBByCustomer[group.Key] = canonical.DateOfBirth.Trim();
                if (!string.IsNullOrWhiteSpace(canonical.LastConfirmedReportingPeriod))
                {
                    previousDOBReportingPeriodByCustomer[group.Key] = canonical.LastConfirmedReportingPeriod.Trim();
                }
            }

        }

        return virtualRecords;
    }

    // ── Phase 4 (BUS): same technique as the IND version above ──────────────
    // One virtual BusinessContext per CustomerID, built from whichever
    // BusinessRef row for that customer was most recently updated. Injected
    // into the same list CheckForChangesInCustomerIDBusregnumTinum already
    // processes -- its existing byCustomerID grouping (section 1) naturally
    // compares a real incoming record's Businessname/Busregnum/Tinum against
    // its own reference history the same way it already compares two records
    // within one file. Caller must remove these again via the returned
    // virtualRecords list (e.g. .Except()) before anything else sees them.
    List<BusinessContext> BuildReferenceVirtualRecordsBus(List<BusinessContext> incoming, List<BusinessRef> fromDatabase, out Dictionary<string, string> previousNameByCustomer)
    {
        var virtualRecords = new List<BusinessContext>();
        previousNameByCustomer = new Dictionary<string, string>();
        if (incoming == null || incoming.Count == 0 || fromDatabase == null || fromDatabase.Count == 0)
            return virtualRecords;

        var customerKeys = incoming
            .Select(r => NormalizeCustomerId(r.CustomerID?.Data))
            .Where(k => !string.IsNullOrWhiteSpace(k))
            .ToHashSet();

        var refByCustomer = fromDatabase
            .Where(r => customerKeys.Contains(NormalizeCustomerId(r.CustomerID)))
            .GroupBy(r => NormalizeCustomerId(r.CustomerID));

        foreach (var group in refByCustomer)
        {
            var canonical = group.OrderByDescending(r => r.LastUpdatedDate).First();

            CellDataAndStatus Cell(string? v)
            {
                var value = v ?? string.Empty;
                return new CellDataAndStatus(value) { Data = value };
            }

            virtualRecords.Add(new BusinessContext
            {
                CustomerID       = Cell(canonical.CustomerID),
                Facilityaccnum   = Cell(canonical.CreditFacilityAccNum),
                DisbursementDate = Cell(canonical.DisbursementDate),
                Businessname     = Cell(canonical.Businessname),
                Busregnum        = Cell(canonical.Busregnum),
                Tinum            = Cell(canonical.Tinum),
            });

            if (!string.IsNullOrWhiteSpace(canonical.Businessname))
            {
                previousNameByCustomer[group.Key] = canonical.Businessname.Trim();
            }
        }

        return virtualRecords;
    }

    (List<IndividualContext> allRecords, List<IndividualContext> duplicatesInd, string correctDateOfBirth, string dobIssues, string matchdata, string newdata, string duplicatescount) REF_MainMatcherTransformerInd_Clean_IND(List<IndividualRef> fromDatabase, List<IndividualContext> _fromExcelFile, bool handleDuplicates = true)
    {
        // Initialize lists to store processed Excel records and duplicates
        List<IndividualContext> processedExcelRecords = new List<IndividualContext>();
        List<IndividualContext> duplicatesList = new List<IndividualContext>();

        // Preprocess the Excel records to flag potential duplicate Date of Birth issues
        var fromExcelFile = AssignDuplicateDoBIssues(_fromExcelFile);

        if (handleDuplicates)
        {
            // Dictionary tracks the BEST record seen so far per key (lowest CurBal wins).
            // Key: (AccNum, CustomerID, DisbursementDate)
            // Value: the record currently kept as the clean version
            var seenKeys = new Dictionary<(string, string, string?), IndividualContext>();
            processedExcelRecords = new List<IndividualContext>();

            foreach (var record in fromExcelFile)
            {
                var key = (
                    NormalizeAccountNumber(record.CreditFacilityAccNum?.Data),
                    NormalizeCustomerId(record.CustomerID?.Data),
                    record.DisbursementDate?.Data
                );

                // Overdraft facilities legitimately appear multiple times — exempt from duplicate rule
                bool isOverdraft = (record.CreditFacilityType?.Data ?? string.Empty)
                    .Trim().ToUpperInvariant() == "V";

                if (seenKeys.TryGetValue(key, out var existing) &&
                    string.IsNullOrWhiteSpace(record.DuplicateDoBIssues) && !isOverdraft)
                {
                    // Before treating this as a duplicate to collapse, confirm
                    // it's actually the same person -- the key alone
                    // (AccNum+CustomerID+DisbursementDate) doesn't guarantee
                    // that. Same tolerance as the rest of the name-conflict
                    // logic: CompareNameTokens' own "at least two matching
                    // tokens" rule.
                    var (_, _, namesSame, _) = CompareNameTokens(
                        existing.Surname?.Data ?? string.Empty, existing.FirstName?.Data ?? string.Empty, existing.MiddleNames?.Data ?? string.Empty,
                        record.Surname?.Data ?? string.Empty, record.FirstName?.Data ?? string.Empty, record.MiddleNames?.Data ?? string.Empty);

                    if (!namesSame)
                    {
                        // Not a duplicate -- a genuine identity conflict on the
                        // same facility. Let it through untouched (don't add to
                        // duplicatesList, don't touch seenKeys) so
                        // RunAllCrossRecordChecksIND downstream sees the full
                        // group and flags every one of them for UNL, instead of
                        // one surviving as CLEAN while the rest silently vanish
                        // into the DUP sheet.
                        processedExcelRecords.Add(record);
                        continue;
                    }

                    // Duplicate found — compare CurBal to decide which to keep
                    decimal? incomingBal = ParseCurBal(record.CurBal?.Data);
                    decimal? existingBal = ParseCurBal(existing.CurBal?.Data);

                    bool keepIncoming;
                    if (incomingBal.HasValue && existingBal.HasValue)
                        keepIncoming = incomingBal.Value < existingBal.Value;  // lower wins
                    else if (incomingBal.HasValue && !existingBal.HasValue)
                        keepIncoming = true;   // known value beats blank
                    else
                        keepIncoming = false;  // existing wins if incoming is blank or equal

                    if (keepIncoming)
                    {
                        // Swap: existing goes to duplicate sheet, incoming becomes the kept record
                        duplicatesList.Add(existing);
                        seenKeys[key] = record;
                        // Replace existing in processedExcelRecords
                        var idx = processedExcelRecords.IndexOf(existing);
                        if (idx >= 0) processedExcelRecords[idx] = record;
                        else processedExcelRecords.Add(record);
                    }
                    else
                    {
                        duplicatesList.Add(record); // incoming loses — goes to duplicate sheet
                    }
                }
                else
                {
                    seenKeys[key] = record;
                    processedExcelRecords.Add(record);
                }
            }
        }
        else
        {
            processedExcelRecords = fromExcelFile.ToList();
        }

        // Create a dictionary from database records for quick lookup by (CreditFacilityAccNum, CustomerID).
        // A facility can legitimately have MULTIPLE historical rows (one per DisbursementDate ever seen —
        // this is the whole point for overdrafts). Keep the full list per key instead of collapsing to
        // the last-seen row, or history for earlier draws silently disappears.
        var databaseDict = new Dictionary<(string, string), List<IndividualRef>>();
        foreach (var dbRecord in fromDatabase)
        {
            var key = (NormalizeAccountNumber(dbRecord.CreditFacilityAccNum), NormalizeCustomerId(dbRecord.CustomerID));
            if (!databaseDict.TryGetValue(key, out var list))
            {
                list = new List<IndividualRef>();
                databaseDict[key] = list;
            }
            list.Add(dbRecord);
        }

        // Initialize counters for various types of matches/issues
        int __correctDateOfBirth = 0;
        int __dobIssues = 0;
        int __matchdata = 0;
        int __newdata = 0;
        int __burscount = 0; // Count of disbursement date mismatch

        // Compare each processed Excel record against database entries
        foreach (var excelRecord in processedExcelRecords)
        {
            var creditFacilityAccNum = NormalizeAccountNumber(excelRecord.CreditFacilityAccNum?.Data);
            var customerID = NormalizeCustomerId(excelRecord.CustomerID?.Data);
            var disbursementDate = excelRecord.DisbursementDate?.Data;

            var key = (creditFacilityAccNum, customerID);

            if (databaseDict.TryGetValue(key, out var dbRecords) && dbRecords.Count > 0)
            {
                // Found matching facility in the database (possibly multiple historical rows —
                // one per DisbursementDate ever accepted for this facility)
                var excelDob = excelRecord.DateOfBirth?.Data;
                __matchdata++;

                // Overdraft facilities legitimately redraw on new dates — exempt from the
                // disbursement-date-mismatch rule, same exemption already applied to the
                // intra-file duplicate check above.
                bool isOverdraft = (excelRecord.CreditFacilityType?.Data ?? string.Empty)
                    .Trim().ToUpperInvariant() == "V";

                // Prefer the historical row matching this exact date (for DOB comparison / name);
                // fall back to any row on file for the facility if this date is genuinely new.
                var dbRecord = dbRecords.FirstOrDefault(r => r.DisbursementDate == disbursementDate)
                                ?? dbRecords[0];

                // ── Sprint 10: Store reference canonical name for validation pass ──
                // If the reference has name data, record it so the validation pass
                // can trust names that were accepted in the previous clean.
                if (!string.IsNullOrWhiteSpace(dbRecord.Surname) || !string.IsNullOrWhiteSpace(dbRecord.FirstName))
                {
                    excelRecord.ReferenceCanonicalName =
                        NormaliseNameSortedTokens(
                            dbRecord.Surname  ?? string.Empty,
                            dbRecord.FirstName ?? string.Empty);
                }

                // Check if this DisbursementDate has been seen before for this facility
                bool dateOnFile = dbRecords.Any(r => r.DisbursementDate == disbursementDate);

                if (!dateOnFile && !isOverdraft)
                {
                    excelRecord.DisburStatus = " THE DISBURSEMENT DATE DOES NOT MATCH THE PREVIOUS SUBMISSION ";
                    __burscount++;
                }
                else if (dbRecord.DateOfBirth == excelDob)
                {
                    __correctDateOfBirth++; // DOB matches
                }
                else
                {
                    excelRecord.Status = "DOB"; // Flag DOB mismatch
                    __dobIssues++;
                }
            }
            else
            {
                // No match found - it's new data
                __newdata++;
            }
        }

        // Return the final processed results
        return (
            processedExcelRecords,
            duplicatesList,
            __correctDateOfBirth.ToString(),
            __dobIssues.ToString(),
            __matchdata.ToString(),
            __newdata.ToString(),
            duplicatesList.Count.ToString()
        );
    }
    List<IndividualContext> AssignDuplicateDoBIssues(List<IndividualContext> individuals)
    {
        // Group records by CreditFacilityAccNum and CustomerID
        var groups = individuals.GroupBy(i => new
        {
            Credit = NormalizeAccountNumber(i.CreditFacilityAccNum?.Data),
            Customer = NormalizeCustomerId(i.CustomerID?.Data),
        });

        // For each group
        foreach (var group in groups)
        {
            // If more than one record exists for the same key
            if (group.Count() > 1)
            {
                // Extract all DateOfBirth values
                var dobValues = group.Select(i => i.DateOfBirth?.Data);

                // Extract all Disbursement date values
                var disValues = group.Select(i => i.DisbursementDate?.Data);

                // Check if DOBs differ
                if (dobValues.Distinct().Count() > 1)
                {
                    // Mark all records in this group with duplicate DOB issue
                    foreach (var individual in group)
                    {
                        individual.DuplicateDoBIssues = "UNL";
                    }
                }
                // Check if Disbursment date differ
                if (disValues.Distinct().Count() > 1)
                {
                    // Overdraft facilities legitimately redraw multiple times in the same
                    // submission month, each with a different date — that's expected, not
                    // a duplicate. Same exemption as the cross-submission check.
                    foreach (var individual in group)
                    {
                        bool isOverdraft = (individual.CreditFacilityType?.Data ?? string.Empty)
                            .Trim().ToUpperInvariant() == "V";
                        if (!isOverdraft)
                        {
                            individual.DisbursementDateMisMatch = "UNL";
                        }
                    }
                }

            }
        }

        // Return updated list
        return individuals;
    }

    // ── BUS equivalent, disbursement-date only ───────────────────────────────
    // BusinessContext.DateOfBirth is a plain string (not a validated
    // CellDataAndStatus field, unlike Individual) -- there's no meaningful
    // "duplicate DOB" concept for a business, so this only ports the
    // disbursement-date half of AssignDuplicateDoBIssues, which is the part
    // that actually matters here: an overdraft facility legitimately redrawn
    // more than once in the same submission shouldn't be flagged.
    List<BusinessContext> AssignDuplicateDoBIssuesBus(List<BusinessContext> businesses)
    {
        var groups = businesses.GroupBy(b => new
        {
            Credit = NormalizeAccountNumber(b.Facilityaccnum?.Data),
            Customer = NormalizeCustomerId(b.CustomerID?.Data),
        });

        foreach (var group in groups)
        {
            if (group.Count() > 1)
            {
                var disValues = group.Select(b => b.DisbursementDate?.Data);
                if (disValues.Distinct().Count() > 1)
                {
                    foreach (var business in group)
                    {
                        bool isOverdraft = (business.CreditFacilityType?.Data ?? string.Empty)
                            .Trim().ToUpperInvariant() == "V";
                        if (!isOverdraft)
                        {
                            business.DisbursementDateMisMatch = "UNL";
                        }
                    }
                }
            }
        }

        return businesses;
    }
