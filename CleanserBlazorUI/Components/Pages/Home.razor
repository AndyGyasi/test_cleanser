    async Task<byte[]> REF_SaveToExcelAsync<T>(List<T> context)
    {
        return await Task.Run(() =>
        {

            using (var wb = new XLWorkbook())
            {
                var ws = wb.Worksheets.Add("TBC");
                var wsu = wb.Worksheets.Add("DOB ERRORS");
                var wsd = wb.Worksheets.Add("DUPLICATE");

                if (typeof(T) == typeof(DBBusinessContext))
                {
                    REF_WriteHeaders(ws, wsu, wsd, SpreadSheetHeadersData.Business, 159);
                    REF_WriteData(context.OfType<DBBusinessContext>().ToList(), ws, wsu);
                }
                else if (typeof(T) == typeof(DBIndividualContext))
                {
                    REF_WriteHeaders(ws, wsu, wsd, SpreadSheetHeadersData.Individual, 179);
                    REF_WriteData(context.OfType<DBIndividualContext>().ToList(), ws, wsu);
                }

                using var stream = new MemoryStream();
                wb.SaveAs(stream);
                return stream.ToArray();
            }
        });
    }
    async Task<(List<T> REF_excelDataReceived, SpreadSheetStatusContext spreadSheetStatus)> REFReadFromExcelAsync<T>(Stream fileResult, string _filename, string exceltype, int chunkSize = 100)
    {
        return await Task.Run(() =>
        {
            REF_filename = _filename;
            var excelDataReceived = new List<T>();
            var spreadSheetStatus = new SpreadSheetStatusContext();
            using (var wb = new XLWorkbook(fileResult))
            {
                var ws = wb.Worksheet(1);
                var rows = ws.RowsUsed().ToList();
                var headerRow = ws.Row(1);
                if (headerRow == null) { return (excelDataReceived, spreadSheetStatus); }
                var actualHeaders = headerRow.Cells().Select(cell => cell.GetValue<string>().Trim().ToLower().Replace(" ", "")).ToList();
                if (exceltype == "bus")
                {
                    var expectedHeaders = SpreadSheetHeadersData.Business.Select(h => h.Trim().ToLower()).ToList();
