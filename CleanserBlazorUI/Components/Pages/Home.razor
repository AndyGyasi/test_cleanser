@page "/"
@rendermode InteractiveServer
@using CleanserBlazorUI.DevelopmentFolder
@using ICleanserBlazorUI.Interface
@using CleanserBlazorUI.Services
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@* @implements IDisposable *@
@inject ISnackbar Snackbar
@inject DataManagementService DataManagementService
@inject UserManager<ApplicationUser> UserManager
@inject ICustomEmailSender EmailSender
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IdentityRedirectManager RedirectManager
@inject ILogger<Home> Logger


@attribute [Authorize]
<div>
    <div style="width:100%; background: #001D23">
        <MudAlert Class="@AlertSeverityVisible" Severity="@AlertSeverity">@AlertSeverityMessage</MudAlert>
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Buffer="true" Class="@progressIsVisible" Style="margin-top: 10px; margin-bottom: 0px;" />
        <style>
            .format-pills { display:flex; gap:2px; background: var(--mud-palette-background-grey, #0F2225); border:1px solid var(--mud-palette-lines-default, #22383B); border-radius:8px; padding:3px; margin-bottom:14px; width: fit-content; }
            .format-pill { font-size:13px; padding:9px 16px; border-radius:6px; border:none; background:transparent; color: var(--mud-palette-text-secondary, #93A29C); cursor:pointer; font-family: inherit; }
            .format-pill.active { background: var(--mud-palette-primary, #1D9E75); color: #06231A; font-weight:600; }
        </style>
        @* Replaces the previous MudExpansionPanels accordion (4 panels, only one
           open at a time) with a pill selector over one shared workspace below.
           Reuses the exact same state (expandPanelSelectedOption) and the exact
           same reset-on-switch method (OnPanelExpandedChanged) the accordion
           already used -- no change to what happens when you switch formats,
           only how you pick one. *@
        <div class="format-pills">
            @foreach (var item in TopExpandPanelsContent!)
            {
                <button type="button" class="format-pill @(expandPanelSelectedOption == item.IdShortName ? "active" : "")" @onclick="() => OnPanelExpandedChanged(item.IdShortName)">@item.Title</button>
            }
        </div>
        @foreach (var item in TopExpandPanelsContent!)
        {
            <div style="display:@(expandPanelSelectedOption == item.IdShortName ? "block" : "none")">
                    <MudStack Style="width: 100%">
                        <style>
                            /* Dark theme styles */
                            .dropzone {
                                width: 100%;
                                padding: 40px;
                                border: 2px dashed #40953e; /* Blue accent */
                                background-color: transparent; /* Dark background */
                                color: #ccc; /* Light text */
                                text-align: center;
                                cursor: pointer;
                                transition: background-color 0.3s ease, border-color 0.3s ease;
                                position: relative;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                                border-radius: 8px;
                            }

                                .dropzone:hover {
                                    background-color: transparent; /* Slightly lighter on hover */
                                    border-color: #40953e;
                                }

                                .dropzone.dragover {
                                    background-color: #333; /* Subtle highlight */
                                    border-color: #40953e; /* Bright blue highlight */
                                    box-shadow: 0 0 10px rgba(0, 29, 35, 0.3);
                                }

                                /* Hide the file input but keep it functional */
                                .dropzone input[type="file"] {
                                    position: absolute;
                                    width: 100%;
                                    height: 100%;
                                    opacity: 0;
                                    cursor: pointer;
                                }

                            /* Uploaded file list */
                            .file-list {
                                margin-top: 10px;
                                padding: 0;
                                list-style: none;
                            }

                                .file-list li {
                                    padding: 8px;
                                    background: #292929;
                                    border: 1px solid #444;
                                    border-radius: 4px;
                                    margin-bottom: 5px;
                                    color: #ddd;
                                }
                        </style>

                        <div @ref="DropZone" class="dropzone">
                            <p>Drag & drop Excel files here or <strong>click to select</strong></p>
                            <InputFile OnChange="REF_FileUpload" multiple accept="@ACCEPTED_FILETYPE" />
                        </div>

                        @if (isLoading)
                        {
                            <p>Uploading...</p>
                        }
                        else
                        {
                            <ul>
                                @foreach (var file in spreadsheetFileAndChipColor)
                                {
                                    <MudChip T="String" IconColor="Color.Error" Color="file.SpreadsheetFileColor" OnClose="() => RemoveFile(file)">@file.SpreadsheetFile.Name</MudChip>
                                }
                            </ul>
                        }
                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <div>@ErrorMessage</div>
                        }
                    </MudStack>
                    <MudPaper Class="d-flex flex-row py-3 px-2" Elevation="24" Style="@($"color:{Colors.LightGreen.Accent3}; background:{Colors.BlueGray.Darken4};")">
                        <MudButtonGroup Color="Color.Primary" Variant="Variant.Text" DropShadow="true">
                            <MudButton OnClick="() => ToggleCleaningViewOrRefView(1)">CLEANING A FILE</MudButton>
                            <MudButton OnClick="() => ToggleCleaningViewOrRefView(2)">REFERENCE / REGISTER RECORDS</MudButton>
                        </MudButtonGroup>
                    </MudPaper>
                    <MudDivider Class="mb-3"></MudDivider>
                    <div class="@cleaningView">
                        <MudPaper class="d-flex flex-row py-1" Elevation="0">
                            <MudButton Variant="Variant.Text" Color="Color.Inherit">DUPLICATE RECORD: @duplicateCount</MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Inherit">NEW RECORD: @newdata</MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Inherit">MATCH RECORD: @matchdata</MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Inherit">DOBISSUES: @dobIssues</MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Inherit">CORRECT DOB: @correctDateOfBirth</MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Inherit">TOTAL: @readCounting</MudButton>
                            <MudSpacer></MudSpacer>
                            <MudCheckBox Class="my-1 mx-1" style="padding-right: 10px;" Color="Color.Primary" @bind-Value="CleanOnlyOrCleanAndReference" Label="CLEAN ONLY"></MudCheckBox>
                            <MudButton Class="my-1 mx-1" Variant="Variant.Filled" Color="Color.Error" OnClick="ClearSeletedFiles">Reload Cleanser</MudButton>
                            @* <MudButton Class="my-1 mx-1" Variant="Variant.Filled" Color="Color.Primary" OnClick="() => RunCleanser(item.Id)"> Run Cleanser</MudButton> *@

                            <MudButton Class="my-1 mx-1" Variant="Variant.Filled" Color="Color.Primary" Disabled="@_processing" OnClick="() => RunCleanser(item.Id)">
                                @if (_processing)
                                {
                                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                    <MudText Class="ms-2">Cleaning</MudText>
                                }
                                else
                                {
                                    <MudText>Run Cleanser</MudText>
                                }
                            </MudButton>
                        </MudPaper>
                    </div>

                    <div class="@unlLogPanelView">
                        <MudDivider Class="mb-3"></MudDivider>
                        <MudAlert Severity="MudBlazor.Severity.Info" Class="mb-3" Dense="true">
                            Generates the unloadable log's header row plus the Demographic/Financial rejection
                            breakdown tables for the file just cleaned (@((_lastUnlDataType == "BUS" ? _lastUnlBatchBus?.Count : _lastUnlBatchInd?.Count) ?? 0) UNL records).
                            Subscriber Name / Institution Type are filled in once per subscriber and remembered
                            after that. Date Emailed / Date Fixed are left blank for now to fill in manually.
                        </MudAlert>
                        <MudGrid>
                            <MudItem xs="12" sm="4">
                                <MudTextField @bind-Value="UnlLogAssociate" Label="Associate" Variant="Variant.Outlined" Margin="Margin.Dense"></MudTextField>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudTextField @bind-Value="UnlLogSubscriberName" Label="Subscriber Name" Variant="Variant.Outlined" Margin="Margin.Dense"></MudTextField>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudTextField @bind-Value="UnlLogInstitutionType" Label="Institution Type" Variant="Variant.Outlined" Margin="Margin.Dense"></MudTextField>
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField @bind-Value="UnlLogComments" Label="Comments" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2"></MudTextField>
                            </MudItem>
                        </MudGrid>
                        <MudPaper Class="d-flex flex-row align-center py-2" Elevation="0">
                            <MudCheckBox Class="my-1 mx-1" Color="Color.Primary" @bind-Value="UnlLogSaveSubscriberInfo" Label="Remember Subscriber Name / Institution Type for next time"></MudCheckBox>
                            <MudSpacer></MudSpacer>
                            <MudButton Class="my-1 mx-1" Variant="Variant.Filled" Color="Color.Warning" OnClick="GenerateUnloadableLogClicked">Generate Unloadable Log</MudButton>
                        </MudPaper>
                    </div>

                    <div class="@referenceView">
                        <MudDivider Class="mb-3"></MudDivider>
                        <MudAlert Severity="MudBlazor.Severity.Info" Class="mb-3" Dense="true">
                            Use this tab to register records into the reference database without running them
                            through CLEAN/UNL routing. This covers two cases: (1) loading a subscriber's initial
                            reference data, and (2) <strong>registering manually rescued records</strong> — after
                            an associate manually cleans and adds records to the CLEAN sheet, upload that corrected
                            CLEAN sheet here and click "Register / Insert reference(s)" so those records are trusted
                            next month too. <strong>Keep the file's original name prefix intact</strong> (the part
                            before the first "_") — that's how the subscriber is identified; renaming it will cause
                            records to register against the wrong subscriber or fail silently.
                        </MudAlert>
                        <MudPaper Class="d-flex flex-row" Elevation="0">
                            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="REF_ClearSeletedFiles">Reload Cleanser</MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Warning" OnClick="REF_InsertThisAsLatesReference_WithConfirm">@RegisterButtonLabel</MudButton>
                            <MudSpacer></MudSpacer>
                            <MudButton Variant="Variant.Text" Color="Color.Inherit">DUPLICATE RECORD: @duplicateCount</MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Inherit">NEW RECORD: @newdata</MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Inherit">MATCH RECORD: @matchdata</MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Inherit">DOBISSUES: @dobIssues</MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Inherit">CORRECT DOB: @correctDateOfBirth</MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Inherit">TOTAL: @readCounting</MudButton>
                        </MudPaper>
                    </div>



                </div>
            }

    </div>
    @*  <>Result from file upload</> *@
    @if (GetErrorsPairsList.Count > 0)
    {
        <div style="width:100%;">
            <MudPaper Class="p-0 m-0" Elevation="0" MinHeight="300">
                <MudTabs AlwaysShowScrollButtons="false" Outlined="true" Position="@Position.Top" Rounded="true" Border="true" ApplyEffectsToContainer="true" Class="mt-5" PanelClass="pa-6">
                    @*  <>--------------Failed 1----------------</> *@

                    <MudTabPanel Text="INVALID HEADERS" BadgeData="@numberOffailedCount" BadgeColor="Color.Error" Class="m-0 p-0">
                        <MudExpansionPanels>
                            @if (GetErrorsPairsList != null && GetErrorsPairsList.Any() && GetAllFailedFileLenght() != null && GetAllFailedFileLenght().Count == GetErrorsPairsList.Count)
                            {
                                for (int i = 0; i < GetErrorsPairsList.Count; i++)
                                {
                                    var errorsGroup = GetErrorsPairsList[i];
                                    var panelTitle = GetAllFailedFileLenght()[i];

                                    <MudExpansionPanel Text="@panelTitle">
                                        <MudTable Items="errorsGroup" Bordered="false" Striped="false" Elevation="0">
                                            <HeaderContent>
                                                <MudTh>Expected Header</MudTh>
                                                <MudTh>Uploaded Header</MudTh>
                                            </HeaderContent>
                                            <RowTemplate>
                                                <MudTd>@context.ExpectedHeader</MudTd>
                                                <MudTd><MudText Color="Color.Error">@context.UploadedHeader</MudText></MudTd>
                                            </RowTemplate>
                                        </MudTable>
                                    </MudExpansionPanel>
                                }
                            }
                            else
                            {
                                <MudExpansionPanel Text="No Data">
                                    <p>No errors to display.</p>
                                </MudExpansionPanel>
                            }
                        </MudExpansionPanels>

                    </MudTabPanel>
                </MudTabs>
            </MudPaper>
        </div>
    }
</div>





@code {
    bool _processing = false;
    string expandPanelSelectedOption = string.Empty;
    string isSubscriber_X_or_Y = string.Empty;
    List<BusinessContext> duplicatesBus = new List<BusinessContext>();
    string correctDateOfBirth; string dobIssues; string matchdata; string newdata; string duplicateCount;
    string cleaningView = "d-block";
    string referenceView = "d-block";
    bool CleanOnlyOrCleanAndReference { get; set; }

    // ── Unloadable Log (on-demand, section 1 header row + rejection breakdown) ──
    List<IndividualContext>? _lastUnlBatchInd = null;
    int _lastDuplicateCountInd = 0;
    int _lastTotalRecordsInd = 0;
    List<BusinessContext>? _lastUnlBatchBus = null;
    int _lastDuplicateCountBus = 0;
    int _lastTotalRecordsBus = 0;
    string _lastUnlFilename = string.Empty;
    string _lastUnlSubcode = string.Empty;
    string _lastUnlDataType = string.Empty;
    string _lastUnlReportingPeriod = string.Empty;
    string _lastUnlReportingYear = string.Empty;
    string _lastUnlMonths = string.Empty;
    string _lastUnlLogYear = string.Empty;
    string unlLogPanelView = "d-none";
    string UnlLogAssociate = string.Empty;
    string UnlLogSubscriberName = string.Empty;
    string UnlLogInstitutionType = string.Empty;
    string UnlLogComments = string.Empty;
    bool UnlLogSaveSubscriberInfo = true;
    int _unlLogSerialCounter = 0;
    MudBlazor.Severity AlertSeverity { get; set; } = MudBlazor.Severity.Success;
    string AlertSeverityMessage;
    System.Timers.Timer _timer;
    TimeSpan _elapsedTime = TimeSpan.Zero;
    bool _isRunning = false;
    int writeCounting = 0;
    int readCounting = 0;
    ElementReference DropZone;
    bool _jsInitialized = false;
    bool PRINT_EXCEL_WITH_SECURED_NAME = false;
    string ACCEPTED_FILETYPE = ".xls,.xlsx";
    long MAX_FILESIZE = 5L * 1024L * 1024L * 1024L;
    int MAX_FILES = 500;
    int FILE_NAME_LENGHT = 3;
    string UPLOADED_FILE_DIRECTORY = "temp";
    List<ErrorsPairs>? GetErrorsPairs;
    List<List<ErrorsPairs>>? GetErrorsPairsList = new List<List<ErrorsPairs>>();
    bool IsProcessingExcelLoadingBarVisible = false;
    List<string>? fullPastFilesPaths = new List<string>();
    List<string>? fullFailedFilesPaths = new List<string>();
    string? FullExcelDataFilePath;
    string numberOfPassedCount = $"Passed Files (0)";
    string numberOffailedCount = "0";
    List<List<List<object>>> passedRecord = new();
    List<List<List<object>>> failedRecord = new();
    string progressIsVisible = "d-none";
    string AlertSeverityVisible = "d-none";
    bool isLoading = false;
    List<List<object>> SingleSheetRecords = new();
    int currentRowCount = 0;
    bool OpenExpandedPanel = false;
    int currentFileCount = 0;
    List<SpreadsheetFileAndChipColor> spreadsheetFileAndChipColor = new();
    string? FileName { get; set; }
    long FileSize { get; set; }
    string? FileSizeInString { get; set; }
    string? ErrorMessage { get; set; }
    DataCleaningType dataCleaningType = new();
    List<DataCleaningTypeModel>? TopExpandPanelsContent { get; set; } = new();
    StringHelper stringHelper = new StringHelper();
    List<string> allowedFileNames = new();
    List<string> shortCodes = new();
    string showSkeleton = "d-block";
    string showMainPage = "d-none";
    string _buttonText = "Reply";
    int numberofFileswithoutreference = 0;
    string oldselectedPanel = string.Empty;
    string REF_filename = string.Empty;
    string filename = string.Empty;
    List<string> settingDataSettings = new();
    bool userNotAllowed = true;
    Dictionary<string, string> shortForms = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

    async Task REF_StartReferencing(int id)
    {
        StartTimer();
        passedRecord.Clear();
        failedRecord.Clear();
        progressIsVisible = "d-block";
        var _spreadsheetFileAndChipColor = spreadsheetFileAndChipColor.Select(passed => passed.IsPassed).ToList();
        foreach (var item in spreadsheetFileAndChipColor)
        {
            await REF_GetSpreadsheetData(item.SpreadsheetFile, id);
        }
        numberOfPassedCount = $"Passed Files ({passedRecord.Count})";
        numberOffailedCount = failedRecord.Count.ToString();
        progressIsVisible = "d-none";
    }
    // ── Register requires a confirmation click ──────────────────────────────
    // REGISTER deliberately bypasses every CLEAN/UNL check -- that's its whole
    // point (loading manually-verified records, e.g. names that only *look*
    // like business names but checked out fine by hand). Since it's an
    // unchecked path into the single source of truth, require a second click
    // before it actually runs, so it's never triggered by accident.
    bool _registerConfirmArmed = false;
    string RegisterButtonLabel = "Register / Insert reference(s)";

    async Task REF_InsertThisAsLatesReference_WithConfirm()
    {
        if (!_registerConfirmArmed)
        {
            _registerConfirmArmed = true;
            RegisterButtonLabel = "Click again to confirm — no CLEAN/UNL check will run";
            AlertSeverityMessage = "These records will be registered exactly as uploaded, with no CLEAN/UNL check. Click Register again to confirm, or navigate away to cancel.";
            AlertSeverity = MudBlazor.Severity.Warning;
            AlertSeverityVisible = "d-block";
            StateHasChanged();
            return;
        }
        _registerConfirmArmed = false;
        RegisterButtonLabel = "Register / Insert reference(s)";
        await REF_InsertThisAsLatesReference();
    }

    async Task REF_InsertThisAsLatesReference()
    {
        StartTimer();
        passedRecord.Clear();
        failedRecord.Clear();
        progressIsVisible = "d-block";
        // Only process files whose subscriber code was actually recognized
        // (IsPassed == true). The inverse condition here previously meant this
        // silently skipped every file for a subscriber the system already
        // knows -- exactly backwards from what "Register" is meant to do.
        var _spreadsheetFileAndChipColor = spreadsheetFileAndChipColor.Where(passed => passed.IsPassed == true).ToList();
        foreach (var item in _spreadsheetFileAndChipColor)
        {
            await INSERTREF_REF_GetSpreadsheetData(item.SpreadsheetFile);
        }
        numberOfPassedCount = $"Passed Files ({passedRecord.Count})";
        numberOffailedCount = failedRecord.Count.ToString();
        progressIsVisible = "d-none";
    }

    // ── Unloadable Log: on-demand, for the file most recently cleaned ──
    // Dispatches on _lastUnlDataType ("IND" or "BUS") since IndividualContext
    // and BusinessContext are different T's for UnloadableLogService's
    // generic methods -- everything after that (header, DB persistence,
    // alerts) is identical for either type.
    async Task GenerateUnloadableLogClicked()
    {
        bool isBusiness = _lastUnlDataType == "BUS";
        int unlCount = isBusiness ? (_lastUnlBatchBus?.Count ?? 0) : (_lastUnlBatchInd?.Count ?? 0);

        if (unlCount == 0)
        {
            AlertSeverityMessage = "No unloadable records to report for the last run.";
            AlertSeverity = MudBlazor.Severity.Warning;
            AlertSeverityVisible = "d-block";
            StateHasChanged();
            return;
        }

        if (UnlLogSaveSubscriberInfo && !string.IsNullOrWhiteSpace(_lastUnlSubcode))
        {
            await DataManagementService.SaveSubscriberProfileAsync(_lastUnlSubcode, UnlLogSubscriberName, UnlLogInstitutionType);
        }

        _unlLogSerialCounter++;
        string reasonSummary = isBusiness
            ? UnloadableLogService.BuildUnloadableReasonSummary(_lastUnlBatchBus)
            : UnloadableLogService.BuildUnloadableReasonSummary(_lastUnlBatchInd);

        var header = new UnloadableLogService.UnloadableLogHeader
        {
            SerialNo = _unlLogSerialCounter,
            SubscriberName = UnlLogSubscriberName,
            Subcode = _lastUnlSubcode,
            InstitutionType = UnlLogInstitutionType,
            Associate = UnlLogAssociate,
            Filename = _lastUnlFilename,
            NumberOfRecords = unlCount,
            ReportingPeriod = _lastUnlReportingPeriod,
            ReportingYear = _lastUnlReportingYear,
            UnloadableReason = reasonSummary,
            DateEmailed = string.Empty,
            DateFixed = string.Empty,
            Comments = UnlLogComments,
            DataType = _lastUnlDataType,
            Months = _lastUnlMonths,
            LogYear = _lastUnlLogYear
        };

        byte[] logBytes = isBusiness
            ? UnloadableLogService.GenerateWorkbook(_lastUnlBatchBus, header, _lastDuplicateCountBus, _lastTotalRecordsBus)
            : UnloadableLogService.GenerateWorkbook(_lastUnlBatchInd, header, _lastDuplicateCountInd, _lastTotalRecordsInd);
        string downloadName = $"UnloadableLog_{_lastUnlSubcode}_{_lastUnlReportingYear}{_lastUnlMonths}.xlsx";
        await JS.InvokeVoidAsync("downloadFile", downloadName, logBytes, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");

        // ── Persist header + detail to DB, from the exact same inputs the ──
        // workbook above was built from, so the .xlsx and the DB row can
        // never disagree with each other.
        string dbSaveWarning = string.Empty;
        try
        {
            var messageSummaries = isBusiness
                ? UnloadableLogService.SummarizeByMessage(_lastUnlBatchBus, _lastDuplicateCountBus, _lastTotalRecordsBus)
                : UnloadableLogService.SummarizeByMessage(_lastUnlBatchInd, _lastDuplicateCountInd, _lastTotalRecordsInd);

            var categorySummaries = isBusiness
                ? new List<(string, List<UnloadableLogService.CategoryRejectionSummary>)>
                {
                    ("Demographic", UnloadableLogService.SummarizeByCategory(_lastUnlBatchBus, "Demographic")),
                    ("Financial", UnloadableLogService.SummarizeByCategory(_lastUnlBatchBus, "Financial")),
                    ("FacilitySubmission", UnloadableLogService.SummarizeByCategory(_lastUnlBatchBus, "FacilitySubmission", _lastDuplicateCountBus))
                }
                : new List<(string, List<UnloadableLogService.CategoryRejectionSummary>)>
                {
                    ("Demographic", UnloadableLogService.SummarizeByCategory(_lastUnlBatchInd, "Demographic")),
                    ("Financial", UnloadableLogService.SummarizeByCategory(_lastUnlBatchInd, "Financial")),
                    ("FacilitySubmission", UnloadableLogService.SummarizeByCategory(_lastUnlBatchInd, "FacilitySubmission", _lastDuplicateCountInd))
                };

            await DataManagementService.SaveUnloadableLogAsync(
                _lastUnlSubcode, UnlLogSubscriberName, UnlLogInstitutionType,
                header, messageSummaries, categorySummaries);
        }
        catch (Exception ex)
        {
            // The .xlsx already downloaded successfully above -- a DB hiccup
            // here shouldn't block that or throw away the file the person
            // needs right now. Surface it as a warning instead of losing the
            // run silently.
            dbSaveWarning = $" (warning: could not save to log history: {ex.Message})";
        }

        AlertSeverityMessage = $"Unloadable log generated ({unlCount} records).{dbSaveWarning}";
        AlertSeverity = string.IsNullOrEmpty(dbSaveWarning) ? MudBlazor.Severity.Success : MudBlazor.Severity.Warning;
        AlertSeverityVisible = "d-block";
        StateHasChanged();
    }
    async Task<CleaningStatus> REF_GetSpreadsheetData(IBrowserFile browserFile, int id)
    {
        StreamHelper streamHelper = new();
        if (id == 1)
        {
            try
            {
                // Resetting variables
                FileName = string.Empty; FileSize = default; FileSizeInString = string.Empty; string extension = string.Empty;
                extension = Path.GetExtension(browserFile.Name);
                if (browserFile != null && extension == ".xlsx")
                {
                    FileName = browserFile.Name; FileSize = browserFile.Size; FileSizeInString = $"{streamHelper.ConvertLongToMB(FileSize).ToString()}MB";

                    // Define a secure directory path (outside wwwroot for security)
                    string uploadDirectory = Path.Combine(Environment.WebRootPath, UPLOADED_FILE_DIRECTORY);
                    // Ensure the directory exists
                    if (!Directory.Exists(uploadDirectory)) { Directory.CreateDirectory(uploadDirectory); }

                    // Stream the uploaded file
                    using var filestream = browserFile.OpenReadStream(MAX_FILESIZE);

                    // Generate a secure random file name
                    var randomFileName = $"{Path.GetRandomFileName()}_____{FileName}";


                    // Combine directory with the sanitized file name and extension
                    FullExcelDataFilePath = Path.Combine(uploadDirectory, Path.ChangeExtension(randomFileName, extension));// made of of directory and file name
                    //ExcelDataRecieved.Clear();
                    //SpreadSheetStatus = new();
                    using var destinationStream = new FileStream(FullExcelDataFilePath, FileMode.Create);
                    await filestream.CopyToAsync(destinationStream);

                    var (ExcelDataRecieved, SpreadSheetStatus) = await REFReadFromExcelAsync<DBIndividualContext>(destinationStream, "ind", FileName);


                    //ReadFromExcel(destinationStream, out ExcelDataRecieved, out SpreadSheetStatus);
                    CleanserBlazorUI.DevelopmentFolder.ExtractSpreadSheetHeader.HeaderExtracter(destinationStream);
                    var numberOfHeaderErrors = SpreadSheetStatus.InvalidHeaders.Count;
                    if (numberOfHeaderErrors >= 1)
