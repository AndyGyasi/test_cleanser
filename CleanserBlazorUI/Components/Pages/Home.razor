                {
                    WriteHeaders(ws, wsu, wsd, wsc, SpreadSheetHeadersData.IndividualJudgement, 77);
                    WriteData(context.OfType<IndividualJudgementContext>().ToList(), context_duplicate.OfType<IndividualJudgementContext>().ToList(), new List<IndividualJudgementContext>(), ws, wsu, wsd, wsc);
                }

                using var stream = new MemoryStream();
                wb.SaveAs(stream);
                return stream.ToArray();
            }
        });
    }
    void WriteHeaders(IXLWorksheet ws, IXLWorksheet wsu, IXLWorksheet wsd, IXLWorksheet wsc, List<string> headers, int errorIndex)
    {
        for (int i = 0; i < headers.Count; i++)
        {
            ws.Cell(1, i + 1).Value = headers[i];
            wsu.Cell(1, i + 1).Value = headers[i];
            wsd.Cell(1, i + 1).Value = headers[i];
            wsc.Cell(1, i + 1).Value = headers[i];
        }
        wsu.Cell(1, errorIndex).Value = "--------------- Errors ---------------";
    }
    void WriteData<T>(List<T> rows, List<T> dup_rows, List<T> closed_rows, IXLWorksheet ws, IXLWorksheet wsu, IXLWorksheet wsd, IXLWorksheet wsc) where T : class
    {
        int correctDataCellIndex = 2;
        int correctCellDuplicate = 2;
        int wrongDataCellIndex = 2;
        int closedCellIndex = 2;
        bool iSCleaned = false;

        foreach (var row in rows)
        {
            iSCleaned = ISCleaned(row);
            if (iSCleaned)
            {
                WriteRow(ws, row, ref iSCleaned, ref correctDataCellIndex);
            }
            else
            {
                WriteRow(wsu, row, ref iSCleaned, ref wrongDataCellIndex);
            }
        }
        foreach (var dup_row in dup_rows)
        {
            WriteRow_dup(wsd, dup_row, ref correctCellDuplicate);
        }
        // Closed-facility repeats: already confirmed clean and discrepancy-free by
        // ExtractClosedFacilitiesInd/Bus before ever reaching here, so this writes
        // directly rather than re-running ISCleaned.
        bool closedFlag = true;
        foreach (var closed_row in closed_rows)
        {
            WriteRow(wsc, closed_row, ref closedFlag, ref closedCellIndex);
        }
        ws.Columns().AdjustToContents();
        wsu.Columns().AdjustToContents();
        wsd.Columns().AdjustToContents();
        wsc.Columns().AdjustToContents();
    }
