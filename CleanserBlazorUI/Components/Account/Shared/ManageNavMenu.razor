@using Microsoft.AspNetCore.Identity
@using CleanserBlazorUI.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager NavigationManager

@* Account-settings tabs. The admin links that used to duplicate here (Register
   User, Manage Users, Reference Data, etc.) live in the main sidebar (NavMenu),
   so there is one place to find them instead of two partial lists. *@
<nav class="cx-tabs" aria-label="Account settings">
    <a class="cx-tab" href="Account/Manage" aria-current="@Current("Account/Manage")">Profile</a>
    <a class="cx-tab" href="Account/Manage/ChangePassword" aria-current="@Current("Account/Manage/ChangePassword")">Password</a>
    @if (hasExternalLogins)
    {
        <a class="cx-tab" href="Account/Manage/ExternalLogins" aria-current="@Current("Account/Manage/ExternalLogins")">External logins</a>
    }
</nav>

@code {
    private bool hasExternalLogins;
    private string currentPath = "";

    protected override async Task OnInitializedAsync()
    {
        currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0].Trim('/');
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }

    private string? Current(string path) =>
        currentPath.Equals(path, StringComparison.OrdinalIgnoreCase) ? "page" : null;
}
