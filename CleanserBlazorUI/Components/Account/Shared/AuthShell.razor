@* Two-column frame shared by every signed-out / first-sign-in page: brand panel
   on the left, the page's form on the right. Pages put their <EditForm
   class="cx-auth-form"> (or a <div class="cx-auth-form">) inside. Static-render
   only: the theme toggle is a plain link (?theme=...), which Program.cs turns
   into the theme cookie, because these pages have no live circuit for JS interop. *@
@inject NavigationManager NavigationManager
@using CleanserBlazorUI.Services

<div class="cx-auth">
    <section class="cx-auth-brand" aria-label="About Cleanser">
        <a class="cx-auth-logo" href="" aria-label="XDS Data Ghana"><img src="logocolor.png" alt="XDS Data Ghana" /></a>
        <div class="cx-stack">
            <span class="cx-tag">Cleanser</span>
            <h1>Clean credit data with confidence.</h1>
            <p>Upload files and catch errors before they reach the bureau database.</p>
            <div class="cx-feature-card">
                <div class="cx-field-row"><span class="cx-step-label">SUPPORTED DATA TYPES</span><span class="cx-mono cx-muted">@DataTypeCount</span></div>
                <div style="display:flex;flex-wrap:wrap;gap:8px">
                    @for (var i = 0; i < DataTypeCodes.Length; i++)
                    {
                        <span class="cx-code-chip @(i == 0 ? "first" : "")">@DataTypeCodes[i]</span>
                    }
                </div>
                <ul>
                    <li><svg class="cx-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l4 4 10-10" /></svg>Duplicate and DOB checks on every file</li>
                    <li><svg class="cx-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l4 4 10-10" /></svg>Matching against the reference register</li>
                    <li><svg class="cx-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l4 4 10-10" /></svg>An unloadable log you can filter and export</li>
                </ul>
            </div>
        </div>
        <div class="cx-auth-copy">© @DateTime.Now.Year.ToString() XDS Data Ghana. All rights reserved.</div>
    </section>

    <section class="cx-auth-main" aria-label="@Title">
        <div class="cx-auth-top">
            <a class="cx-auth-logo-sm" href="" aria-label="XDS Data Ghana"><img src="logocolor.png" alt="XDS Data Ghana" /></a>
            <a class="cx-theme-toggle" href="@toggleHref" aria-label="@(isDark ? "Switch to light theme" : "Switch to dark theme")">
                @if (isDark)
                {
                    <svg class="cx-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16a4 4 0 100-8 4 4 0 000 8zM12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                    <span>Light mode</span>
                }
                else
                {
                    <svg class="cx-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 019.5 4 8 8 0 1020 14.5z" /></svg>
                    <span>Dark mode</span>
                }
            </a>
        </div>
        <div class="cx-auth-center">
            <div class="cx-auth-col">@ChildContent</div>
        </div>
        <nav class="cx-auth-legal" aria-label="Legal">
            <a href="privacy-policy">Privacy policy</a>
            <a href="terms-of-service">Terms of service</a>
            <a href="cookie-policy">Cookie policy</a>
        </nav>
    </section>
</div>

@code {
    // The dashboard offers 7 data types (IND, BUS, DUD x2, JUD x2, MOBILE); the chips show the distinct codes.
    private const int DataTypeCount = 7;
    private static readonly string[] DataTypeCodes = { "IND", "BUS", "DUD", "JUD", "MOBILE" };

    [Parameter] public string Title { get; set; } = "Cleanser";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private bool isDark = true;
    private string toggleHref = "";

    protected override void OnInitialized()
    {
        isDark = ThemeService.FromRequest(HttpContext) != "light";
        toggleHref = NavigationManager.GetUriWithQueryParameter("theme", isDark ? "light" : "dark");
    }
}
