<StatusMessage Message="@StatusMessage" />
<h2 class="cx-card-title">Recovery codes</h2>
<div class="cx-alert warn"><span><strong>Put these codes in a safe place.</strong>
    <br />
    If you lose your device and don't have the recovery codes you will lose access to your account.</span></div>
<div class="cx-codes">
    @foreach (var recoveryCode in RecoveryCodes)
    {
        <code class="recovery-code">@recoveryCode</code>
    }
</div>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
