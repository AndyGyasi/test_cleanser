@page "/Account/Manage/PersonalData"

@inject IdentityUserAccessor UserAccessor
@attribute [Authorize(Roles = "notallowed")]
<PageTitle>Personal Data</PageTitle>

<h2 class="cx-card-title">Personal Data</h2>
<StatusMessage />

<p class="cx-sub" style="margin:0">Your account contains personal data that you have given us. This page allows you to download or delete that data.</p>
<p class="cx-sub" style="margin:0"><strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong></p>

<form action="Account/Manage/DownloadPersonalData" method="post" class="cx-form">
    <AntiforgeryToken />
    <button type="submit" class="cx-btn cx-btn-primary">Download</button>
</form>
<a class="cx-btn cx-btn-danger" href="Account/Manage/DeletePersonalData">Delete</a>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _ = await UserAccessor.GetRequiredUserAsync(HttpContext);
    }
}
