@page "/Account/Manage/ChangePassword"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using CleanserBlazorUI.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager NavigationManager
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ChangePassword> Logger

@attribute [AllowAnonymous]

<PageTitle>Password · Cleanser</PageTitle>

<h2 class="cx-card-title">Change password</h2>
<StatusMessage Message="@message" />

<EditForm Model="Input" FormName="change-password" OnValidSubmit="OnValidSubmitAsync" method="post" class="cx-form">
    <DataAnnotationsValidator />

    <div class="cx-field">
        <label for="fld-oldpassword">Current password</label>
        <span class="cx-control">
            <svg class="cx-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 11h14v10H5zM8 11V8a4 4 0 018 0v3" /></svg>
            <InputText id="fld-oldpassword" @bind-Value="Input.OldPassword" type="password" autocomplete="current-password" />
        </span>
        <ValidationMessage For="() => Input.OldPassword" class="cx-error" />
    </div>

    <div class="cx-field">
        <label for="fld-newpassword">New password</label>
        <span class="cx-control">
            <svg class="cx-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 11h14v10H5zM8 11V8a4 4 0 018 0v3" /></svg>
            <InputText id="fld-newpassword" @bind-Value="Input.NewPassword" type="password" autocomplete="new-password" />
        </span>
        <ValidationMessage For="() => Input.NewPassword" class="cx-error" />
    </div>

    <div class="cx-field">
        <label for="fld-confirmpassword">Confirm new password</label>
        <span class="cx-control">
            <svg class="cx-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 11h14v10H5zM8 11V8a4 4 0 018 0v3" /></svg>
            <InputText id="fld-confirmpassword" @bind-Value="Input.ConfirmPassword" type="password" autocomplete="new-password" />
        </span>
        <ValidationMessage For="() => Input.ConfirmPassword" class="cx-error" />
    </div>

    <p class="cx-hint">Use at least 8 characters with upper and lower case letters, a number and a symbol.</p>
    <div class="cx-actions">
        <button type="submit" class="cx-btn cx-btn-primary">Update password</button>
    </div>
</EditForm>

@code {
    private string? message;
    private ApplicationUser user = default!;
    private bool hasPassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get => _input ??= new(); set => _input = value; }
    private InputModel? _input;

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        hasPassword = await UserManager.HasPasswordAsync(user);
        if (!hasPassword)
        {
            Logger.LogWarning("User '{UserId}' attempted to change password but has no password set. Redirecting to SetPassword.", user.Id);
            RedirectManager.RedirectTo("Account/Manage/SetPassword");
        }
    }

    private async Task OnValidSubmitAsync()
    {
        var changePasswordResult = await UserManager.ChangePasswordAsync(user, Input.OldPassword, Input.NewPassword);
        if (!changePasswordResult.Succeeded)
        {
            message = $"Error: {string.Join(",", changePasswordResult.Errors.Select(error => error.Description))}";
            Logger.LogError("Failed to change password for user '{UserId}': {Errors}", user.Id, string.Join(", ", changePasswordResult.Errors.Select(error => error.Description)));
            return;
        }

        var userRoles = await UserManager.GetRolesAsync(user);
        Logger.LogInformation("User '{UserId}' changed their password successfully.", user.Id);
        await UserManager.UpdateAsync(user);

        if (userRoles.Contains("MustChangePassword"))
        {
            var result = await UserManager.RemoveFromRoleAsync(user, "MustChangePassword");
            if (result.Succeeded)
            {
                Logger.LogInformation("Removed 'MustChangePassword' role from user '{UserId}'.", user.Id);
            }
            else
            {
                Logger.LogError("Failed to remove 'MustChangePassword' role from user '{UserId}': {Errors}", user.Id, string.Join(", ", result.Errors.Select(e => e.Description)));
            }
        }

        // Add "user" role if the user has no roles
        if (!userRoles.Any())
        {
            var addRoleResult = await UserManager.AddToRoleAsync(user, "user");
            if (addRoleResult.Succeeded)
            {
                Logger.LogInformation("Added 'user' role to user '{UserId}'.", user.Id);
            }
            else
            {
                message = $"Error adding 'user' role: {string.Join(",", addRoleResult.Errors.Select(error => error.Description))}";
                Logger.LogError("Failed to add 'user' role to user '{UserId}': {Errors}", user.Id, string.Join(", ", addRoleResult.Errors.Select(error => error.Description)));
                return;
            }
        }

        // Sign out FIRST, then redirect: the redirect ends the request, so the old order (redirect, then
        // sign out) never reached the sign-out and left the person signed in on a page whose security
        // stamp had just changed.
        await SignInManager.SignOutAsync();
        Logger.LogInformation("User '{UserId}' signed out after password change.", user.Id);
        RedirectManager.RedirectToWithStatus("Account/Login", "Your password has been changed. Sign in with your new password.", HttpContext);
    }

    private sealed class InputModel
    {
        [Required]
        [DataType(DataType.Password)]
        [Display(Name = "Current password")]
        public string OldPassword { get; set; } = "";

        [Required]
        [StringLength(100, ErrorMessage = "The {0} must be at least {2} and at max {1} characters long.", MinimumLength = 8)]
        [DataType(DataType.Password)]
        [Display(Name = "New password")]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Confirm new password")]
        [Compare("NewPassword", ErrorMessage = "The new password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
