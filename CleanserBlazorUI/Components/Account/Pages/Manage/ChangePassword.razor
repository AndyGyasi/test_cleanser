@page "/Account/Manage/ChangePassword"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using CleanserBlazorUI.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager NavigationManager
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ChangePassword> Logger

@attribute [AllowAnonymous]

<MudText Typo="Typo.h5" Class="mb-4">Change password</MudText>
<StatusMessage Message="@message" />
<EditForm Model="Input" FormName="change-password" OnValidSubmit="OnValidSubmitAsync" method="post">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" role="alert" />
    <div class="login-field" style="max-width: 420px"><label for="fld-oldpassword">Current password</label><InputText id="fld-oldpassword" @bind-Value="Input.OldPassword" type="password" autocomplete="off" /><ValidationMessage For="() => Input.OldPassword" class="text-danger" /></div>
    <div class="login-field" style="max-width: 420px"><label for="fld-newpassword">New password</label><InputText id="fld-newpassword" @bind-Value="Input.NewPassword" type="password" autocomplete="new-password" /><ValidationMessage For="() => Input.NewPassword" class="text-danger" /></div>
    <div class="login-field" style="max-width: 420px"><label for="fld-confirmpassword">Confirm new password</label><InputText id="fld-confirmpassword" @bind-Value="Input.ConfirmPassword" type="password" autocomplete="new-password" /><ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" /></div>
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Update password</MudButton>
</EditForm>

@code {
    private string? message;
    private ApplicationUser user = default!;
    private bool hasPassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get => _input ??= new(); set => _input = value; }
    private InputModel? _input;

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        hasPassword = await UserManager.HasPasswordAsync(user);
        if (!hasPassword)
        {
            Logger.LogWarning("User '{UserId}' attempted to change password but has no password set. Redirecting to SetPassword.", user.Id);
            RedirectManager.RedirectTo("Account/Manage/SetPassword");
        }
    }

    private async Task OnValidSubmitAsync()
    {
        var changePasswordResult = await UserManager.ChangePasswordAsync(user, Input.OldPassword, Input.NewPassword);
        if (!changePasswordResult.Succeeded)
        {
            message = $"Error: {string.Join(",", changePasswordResult.Errors.Select(error => error.Description))}";
            Logger.LogError("Failed to change password for user '{UserId}': {Errors}", user.Id, string.Join(", ", changePasswordResult.Errors.Select(error => error.Description)));
            return;
        }

        var userRoles = await UserManager.GetRolesAsync(user);
        Logger.LogInformation("User '{UserId}' changed their password successfully.", user.Id);
        await UserManager.UpdateAsync(user);

        if (userRoles.Contains("MustChangePassword"))
        {
            var result = await UserManager.RemoveFromRoleAsync(user, "MustChangePassword");
            if (result.Succeeded)
            {
                Logger.LogInformation("Removed 'MustChangePassword' role from user '{UserId}'.", user.Id);
            }
            else
            {
                Logger.LogError("Failed to remove 'MustChangePassword' role from user '{UserId}': {Errors}", user.Id, string.Join(", ", result.Errors.Select(e => e.Description)));
            }
        }

        // Add "user" role if the user has no roles
        if (!userRoles.Any())
        {
            var addRoleResult = await UserManager.AddToRoleAsync(user, "user");
            if (addRoleResult.Succeeded)
            {
                Logger.LogInformation("Added 'user' role to user '{UserId}'.", user.Id);
            }
            else
            {
                message = $"Error adding 'user' role: {string.Join(",", addRoleResult.Errors.Select(error => error.Description))}";
                Logger.LogError("Failed to add 'user' role to user '{UserId}': {Errors}", user.Id, string.Join(", ", addRoleResult.Errors.Select(error => error.Description)));
                return;
            }
        }

        RedirectManager.RedirectToCurrentPageWithStatus("Your password has been changed Logging Out", HttpContext);
        await SignInManager.SignOutAsync();
        Logger.LogInformation("User '{UserId}' signed out after password change.", user.Id);
    }

    private sealed class InputModel
    {
        [Required]
        [DataType(DataType.Password)]
        [Display(Name = "Current password")]
        public string OldPassword { get; set; } = "";

        [Required]
        [StringLength(100, ErrorMessage = "The {0} must be at least {2} and at max {1} characters long.", MinimumLength = 6)]
        [DataType(DataType.Password)]
        [Display(Name = "New password")]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Confirm new password")]
        [Compare("NewPassword", ErrorMessage = "The new password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
