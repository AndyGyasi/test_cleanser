@page "/Account/Login"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using CleanserBlazorUI.Data
@using CleanserBlazorUI.Services
@inject SignInManager<ApplicationUser> SignInManager
@inject ILogger<Login> Logger
@inject IdentityRedirectManager RedirectManager

<PageTitle>Sign in · Cleanser</PageTitle>

@* Native InputText, not MudTextField: this page is static-rendered, and Mud
   inputs emit no name attribute, so the browser would post no Input.* fields,
   [SupplyParameterFromForm] would null Input, and EditForm would throw
   "requires a Model or EditContext". Native inputs emit name="Input.Email" etc. *@
<AuthShell Title="Sign in">
    <EditForm Model="Input" method="post" OnValidSubmit="LoginUser" FormName="login" class="cx-auth-form">
        <DataAnnotationsValidator />

        <div>
            <h2>Sign in</h2>
            <p class="cx-lead" style="margin-top:8px">Use your xdsdata email to login.</p>
        </div>

        @if (Expired)
        {
            <div class="cx-alert info" role="status">You were signed out after a period of inactivity. Sign in again to continue.</div>
        }
        <StatusMessage Message="@errorMessage" />

        <div class="cx-field">
            <label for="login-email">Email address</label>
            <span class="cx-control">
                <svg class="cx-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18v14H3zM3 7l9 6 9-6" /></svg>
                <InputText id="login-email" @bind-Value="Input.Email" type="email" autocomplete="username" aria-required="true" placeholder="name@xdsdata.com" />
            </span>
            <ValidationMessage For="() => Input.Email" class="cx-error" />
        </div>

        <div class="cx-field">
            <span class="cx-field-row">
                <label for="login-password">Password</label>
                <a href="Account/ForgotPassword" style="font-size:13px">Forgot password?</a>
            </span>
            <span class="cx-control">
                <svg class="cx-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 11h14v10H5zM8 11V8a4 4 0 018 0v3" /></svg>
                <InputText id="login-password" @bind-Value="Input.Password" type="password" autocomplete="current-password" aria-required="true" />
                <button type="button" class="cx-icon-btn cx-eye" data-cx="show-pw" data-target="login-password" aria-label="Show password">
                    <svg class="cx-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12zM12 15a3 3 0 100-6 3 3 0 000 6z" /></svg>
                </button>
            </span>
            <ValidationMessage For="() => Input.Password" class="cx-error" />
        </div>

        <button type="submit" class="cx-btn cx-btn-primary cx-btn-block">
            Sign in
            <svg class="cx-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </button>

        <p class="cx-auth-note">
            Forgot your password, or haven't signed in for a while?
            <a href="Account/ForgotPassword">Ask an administrator for a new one</a>.
        </p>
    </EditForm>
</AuthShell>

@code {
    private string? errorMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get => _input ??= new(); set => _input = value; }
    private InputModel? _input;

    [SupplyParameterFromQuery(Name = "expired")]
    private string? ExpiredFlag { get; set; }

    private bool Expired => ExpiredFlag == "1";

    protected override async Task OnInitializedAsync()
    {
        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            // Clear the existing external cookie to ensure a clean login process
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }
    }

    public async Task LoginUser()
    {
        // A temporary password handed over by an admin only works for TemporaryPassword.Lifetime.
        // The message is shown only to someone who typed the right password, so it tells
        // nobody else anything about the account.
        var waiting = await SignInManager.UserManager.FindByEmailAsync(Input.Email);
        if (waiting is not null
            && TemporaryPassword.IsExpired(waiting)
            && await SignInManager.UserManager.IsInRoleAsync(waiting, PasswordChangeMiddleware.RoleName)
            && (await SignInManager.CheckPasswordSignInAsync(waiting, Input.Password, lockoutOnFailure: false)).Succeeded)
        {
            Logger.LogWarning("Expired temporary password used by '{Email}'.", Input.Email);
            errorMessage = "Error: Your temporary password has expired. Use the Forgot password link to ask an administrator for a new one.";
            return;
        }

        // Sessions are never persistent: closing the browser or sitting idle
        // past the admin-set limit ends them. This doesn't count login failures
        // towards account lockout; to enable that, set lockoutOnFailure: true.
        var result = await SignInManager.PasswordSignInAsync(Input.Email, Input.Password, isPersistent: false, lockoutOnFailure: false);
        if (result.Succeeded)
        {
            Logger.LogInformation("User '{Email}' logged in successfully.", Input.Email);

            // Newly created accounts must pick their own password first; everyone
            // else lands on the data cleaning dashboard. (Where the user was
            // heading before sign-in is deliberately not remembered.)
            var user = await SignInManager.UserManager.FindByEmailAsync(Input.Email);
            var mustChange = user != null && await SignInManager.UserManager.IsInRoleAsync(user, PasswordChangeMiddleware.RoleName);
            RedirectManager.RedirectTo(mustChange ? "Account/ChangeTemporaryPassword" : "");
        }
        else if (result.RequiresTwoFactor)
        {
            Logger.LogWarning("User '{Email}' requires two-factor authentication.", Input.Email);
            RedirectManager.RedirectTo("Account/LoginWith2fa", new() { ["rememberMe"] = false });
        }
        else if (result.IsLockedOut)
        {
            Logger.LogWarning("User account '{Email}' locked out.", Input.Email);
            RedirectManager.RedirectTo("Account/Lockout");
        }
        else
        {
            Logger.LogWarning("Invalid login attempt for user '{Email}'.", Input.Email);
            errorMessage = "Error: Invalid login attempt.";
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Enter your email address.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Enter your password.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";
    }
}
