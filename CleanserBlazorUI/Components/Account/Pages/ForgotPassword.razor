@page "/Account/ForgotPassword"
@using System.ComponentModel.DataAnnotations
@using CleanserBlazorUI.Services
@inject PasswordResetRequestService Requests

<PageTitle>Forgot your password? · Cleanser</PageTitle>

@* The app sends no email. Asking for a reset leaves a notice for the administrators (badge and
   banner in Manage users); one of them sets a temporary password and hands it over. The answer
   is the same whether or not the email belongs to an account, so this page cannot be used to
   find out who has one. *@
<AuthShell Title="Forgot your password?">
    @if (sent)
    {
        <div class="cx-auth-form">
            <div>
                <h2>Request sent</h2>
                <p class="cx-lead" style="margin-top:8px">If that email belongs to an account, an administrator has been told. They will give you a temporary password.</p>
            </div>
            <ol class="cx-steps">
                <li>The administrator gives you the temporary password directly. It works for @((int)TemporaryPassword.Lifetime.TotalDays) days.</li>
                <li>Sign in with it, then choose your own password.</li>
            </ol>
            <p class="cx-auth-note">Nothing yet? Contact an administrator directly.</p>
            <a class="cx-btn cx-btn-primary cx-btn-block" href="Account/Login">Back to sign in</a>
        </div>
    }
    else
    {
        <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="SendRequestAsync" method="post" class="cx-auth-form">
            <DataAnnotationsValidator />

            <div>
                <h2>Forgot your password?</h2>
                <p class="cx-lead" style="margin-top:8px">Enter your email and an administrator will be told. They will give you a temporary password.</p>
            </div>

            <div class="cx-field">
                <label for="fp-email">Email address</label>
                <span class="cx-control">
                    <svg class="cx-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18v14H3zM3 7l9 6 9-6" /></svg>
                    <InputText id="fp-email" @bind-Value="Input.Email" type="email" autocomplete="username" aria-required="true" placeholder="name@xdsdata.com" />
                </span>
                <ValidationMessage For="() => Input.Email" class="cx-error" />
            </div>

            <button type="submit" class="cx-btn cx-btn-primary cx-btn-block">
                Notify an administrator
                <svg class="cx-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </button>
            <p class="cx-auth-note"><a href="Account/Login">Back to sign in</a></p>
        </EditForm>
    }
</AuthShell>

@code {
    private bool sent;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get => _input ??= new(); set => _input = value; }
    private InputModel? _input;

    private async Task SendRequestAsync()
    {
        await Requests.RecordAsync(Input.Email.Trim(), HttpContext.Connection.RemoteIpAddress?.ToString());
        sent = true;   // the same answer whether or not an account was found
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Enter your email address.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = "";
    }
}
