@page "/Account/ForgotPassword"
@using CleanserBlazorUI.Services

<PageTitle>Forgot your password? · Cleanser</PageTitle>

@* The app sends no email, so there is no reset link: an administrator resets the password
   from Manage users (Reset password) and gives the person a temporary one directly. *@
<AuthShell Title="Forgot your password?">
    <div class="cx-auth-form">
        <div>
            <h2>Forgot your password?</h2>
            <p class="cx-lead" style="margin-top:8px">For security, passwords are not reset by email. Ask an administrator to reset yours.</p>
        </div>

        <ol class="cx-steps">
            <li>Contact an administrator and ask for a password reset.</li>
            <li>They will give you a temporary password. It works for @((int)TemporaryPassword.Lifetime.TotalDays) days.</li>
            <li>Sign in with it, then choose your own password.</li>
        </ol>

        <a class="cx-btn cx-btn-primary cx-btn-block" href="Account/Login">Back to sign in</a>
    </div>
</AuthShell>
