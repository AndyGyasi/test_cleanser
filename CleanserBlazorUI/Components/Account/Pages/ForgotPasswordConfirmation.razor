@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Check your email · Cleanser</PageTitle>

<AuthShell Title="Check your email">
    <div class="cx-auth-form">
        <div>
            <h2>Check your email</h2>
            <p class="cx-lead" style="margin-top:8px">If that address belongs to an account, a link to reset your password is on its way. It can take a few minutes to arrive.</p>
        </div>
        <a class="cx-btn cx-btn-primary cx-btn-block" href="Account/Login">Back to sign in</a>
    </div>
</AuthShell>
