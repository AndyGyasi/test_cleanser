@page "/Account/ChangeTemporaryPassword"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using CleanserBlazorUI.Data
@attribute [Authorize]
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ChangeTemporaryPassword> Logger

<PageTitle>Set your password · Cleanser</PageTitle>

@* First sign-in for accounts created by an administrator (they carry the
   MustChangePassword role; PasswordChangeMiddleware keeps them on this page
   until they finish). The strength meter and rules list are progressive
   enhancement from _auth.js; every rule is also enforced here and by Identity. *@
<AuthShell Title="Set your password">
    <EditForm Model="Input" method="post" OnValidSubmit="OnValidSubmitAsync" FormName="set-initial-password" class="cx-auth-form" data-cx-pwform>
        <DataAnnotationsValidator />

        <div style="display:flex;flex-direction:column;gap:10px">
            <span class="cx-user-chip"><span class="cx-avatar sm">@initials</span>@email</span>
            <h2>Set your password</h2>
            <p class="cx-lead">Welcome to Cleanser. Your account was created by an administrator. Replace your temporary password to continue.</p>
        </div>

        <StatusMessage Message="@errorMessage" />

        <div class="cx-field">
            <label for="pw-temp">Temporary password</label>
            <span class="cx-control">
                <svg class="cx-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 15a4 4 0 100-8 4 4 0 000 8zM12 11h9M18 11v3M21 11v2" /></svg>
                <InputText id="pw-temp" @bind-Value="Input.TemporaryPassword" type="password" autocomplete="current-password" data-pw="temp" aria-required="true" />
            </span>
            <ValidationMessage For="() => Input.TemporaryPassword" class="cx-error" />
        </div>

        <div class="cx-field">
            <label for="pw-new">New password</label>
            <span class="cx-control">
                <svg class="cx-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 11h14v10H5zM8 11V8a4 4 0 018 0v3" /></svg>
                <InputText id="pw-new" @bind-Value="Input.NewPassword" type="password" autocomplete="new-password" data-pw="new" aria-required="true" />
                <button type="button" class="cx-icon-btn cx-eye" data-cx="show-pw" data-target="pw-new" aria-label="Show password">
                    <svg class="cx-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12zM12 15a3 3 0 100-6 3 3 0 000 6z" /></svg>
                </button>
            </span>
            <span class="cx-meter" aria-live="polite"><i></i><i></i><i></i><i></i><span data-pw-strength>Too weak</span></span>
            <ValidationMessage For="() => Input.NewPassword" class="cx-error" />
        </div>

        <div class="cx-field">
            <label for="pw-confirm">Confirm new password</label>
            <span class="cx-control">
                <svg class="cx-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 11h14v10H5zM8 11V8a4 4 0 018 0v3" /></svg>
                <InputText id="pw-confirm" @bind-Value="Input.ConfirmPassword" type="password" autocomplete="new-password" data-pw="confirm" aria-required="true" />
            </span>
            <ValidationMessage For="() => Input.ConfirmPassword" class="cx-error" />
        </div>

        <ul class="cx-rules" aria-label="Password requirements">
            <li data-rule="len">At least 8 characters</li>
            <li data-rule="case">Upper and lower case letters</li>
            <li data-rule="num">At least one number</li>
            <li data-rule="sym">At least one symbol, like ! # @("@")</li>
            <li data-rule="diff">Different from your temporary password</li>
            <li data-rule="match">Both passwords match</li>
        </ul>

        <button type="submit" class="cx-btn cx-btn-primary cx-btn-block" data-pw-submit>
            Set password and continue
            <svg class="cx-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </button>
    </EditForm>

    <form action="Account/Logout" method="post" class="cx-auth-note cx-signout">
        <AntiforgeryToken />
        <input type="hidden" name="ReturnUrl" value="Account/Login" />
        Not you? <button type="submit" class="cx-linkbtn">Back to sign in</button>
    </form>
</AuthShell>

@code {
    private string? errorMessage;
    private string email = "";
    private string initials = "?";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get => _input ??= new(); set => _input = value; }
    private InputModel? _input;

    protected override void OnInitialized()
    {
        email = HttpContext.User.Identity?.Name ?? "";
        initials = email.Length > 0 ? email[..1].ToUpperInvariant() : "?";

        // Only accounts still flagged need this page; everyone else changes
        // their password from My Account.
        if (!HttpContext.User.IsInRole(PasswordChangeMiddleware.RoleName))
        {
            RedirectManager.RedirectTo("Account/Manage/ChangePassword");
        }
    }

    private async Task OnValidSubmitAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectTo("Account/Login");
            return;
        }

        if (Input.NewPassword == Input.TemporaryPassword)
        {
            errorMessage = "Error: Your new password must be different from the temporary password.";
            return;
        }

        var result = await UserManager.ChangePasswordAsync(user, Input.TemporaryPassword, Input.NewPassword);
        if (!result.Succeeded)
        {
            errorMessage = $"Error: {string.Join(" ", result.Errors.Select(e => e.Description))}";
            Logger.LogWarning("Temporary-password change failed for '{Email}': {Errors}", email, string.Join(", ", result.Errors.Select(e => e.Code)));
            return;
        }

        // They've chosen their own password: lift the requirement. An account
        // left with no roles at all gets the base "user" role so it can sign in
        // to something (same rule the Manage > Change password page applies).
        await UserManager.RemoveFromRoleAsync(user, PasswordChangeMiddleware.RoleName);
        if (!(await UserManager.GetRolesAsync(user)).Any())
        {
            await UserManager.AddToRoleAsync(user, "user");
        }

        // The password change rotated the security stamp and the role is gone:
        // re-issue the sign-in cookie so both are reflected without signing in again.
        await SignInManager.RefreshSignInAsync(user);
        Logger.LogInformation("User '{Email}' set their own password and is no longer flagged to change it.", email);

        RedirectManager.RedirectTo("");
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Enter your temporary password.")]
        [DataType(DataType.Password)]
        public string TemporaryPassword { get; set; } = "";

        [Required(ErrorMessage = "Enter a new password.")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "Your new password must be at least 8 characters long.")]
        [DataType(DataType.Password)]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Confirm your new password.")]
        [DataType(DataType.Password)]
        [Compare(nameof(NewPassword), ErrorMessage = "The two passwords don't match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
