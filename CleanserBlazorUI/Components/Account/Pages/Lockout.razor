@page "/Account/Lockout"

<PageTitle>Account locked · Cleanser</PageTitle>

<AuthShell Title="Account locked">
    <div class="cx-auth-form">
        <div>
            <h2>Account locked</h2>
            <p class="cx-lead" style="margin-top:8px">This account has been locked out. Please try again later, or ask an administrator to unlock it.</p>
        </div>
        <a class="cx-btn cx-btn-ghost cx-btn-block" href="Account/Login">Back to sign in</a>
    </div>
</AuthShell>
