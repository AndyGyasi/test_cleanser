@page "/Account/ResetPasswordConfirmation"

<PageTitle>Password reset · Cleanser</PageTitle>

<AuthShell Title="Password reset">
    <div class="cx-auth-form">
        <div>
            <h2>Password reset</h2>
            <p class="cx-lead" style="margin-top:8px">Your password has been reset. You can now sign in with your new password.</p>
        </div>
        <a class="cx-btn cx-btn-primary cx-btn-block" href="Account/Login">Sign in</a>
    </div>
</AuthShell>
