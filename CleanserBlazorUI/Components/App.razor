<!DOCTYPE html>
<html lang="en" data-theme="@Theme">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["cleanser-ui.css"]" />
    <link rel="stylesheet" href="@Assets["CleanserBlazorUI.styles.css"]" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" rel="stylesheet" />

    <ImportMap />
    <HeadOutlet />
</head>

<body style="background: var(--mud-palette-background); background-color: var(--mud-palette-background);">
    <Routes/>
    <script src="_framework/blazor.web.js"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="_downloadFile.js"></script>
    <script src="_theme.js"></script>
    <script src="_shell.js"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // Same resolution as MainLayout, so first paint already has the right
    // theme (dark unless the visitor explicitly chose light).
    private string Theme => CleanserBlazorUI.Services.ThemeService.FromRequest(HttpContext) == "light" ? "light" : "dark";
}
