@* The app's single chrome element -- logo, dynamic nav, and the user/logout
   footer all live here, inside MainLayout's MudDrawer. Sections and items
   are loaded from the database (NavSection/NavItem) rather than hardcoded,
   so admin can rename sections and drag pages between them from
   /navigation-settings without a code change. Each section is its own
   collapsible MudNavGroup, and renders only if at least one of its items is
   visible to the current user's role. *@
@inject DataManagementService DataManagementService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<div class="d-flex flex-column" style="height: 100%;">
    <div class="pa-4">
        <MudImage Src="logocolor.png" Height="36" />
    </div>

    <div class="px-4 pb-2">
        <MudTextField T="string" @bind-Value="searchText" Placeholder="Search menu" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true" Class="mud-width-full" />
    </div>

    <MudNavMenu Class="flex-grow-1 px-2" style="overflow-y: auto;">
        @foreach (var navSection in sections)
        {
            var visibleItems = navSection.Items
                .Where(IsVisible)
                .Where(MatchesSearch)
                .OrderBy(i => i.DisplayOrder)
                .ToList();

            if (visibleItems.Count > 0)
            {
                <MudNavGroup Title="@navSection.Title" Expanded="@IsExpanded(navSection.Id)"
                             ExpandedChanged="@(v => expandedState[navSection.Id] = v)">
                    @foreach (var item in visibleItems)
                    {
                        <MudNavLink Href="@item.Href" Match="@(item.Href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)" Icon="@ResolveIcon(item.IconKey)">
                            @item.Label
                        </MudNavLink>
                    }
                </MudNavGroup>
            }
        }

        <AuthorizeView Roles="admin">
            <Authorized>
                <MudNavGroup Title="Admin" Expanded="@IsExpanded(-1)" ExpandedChanged="@(v => expandedState[-1] = v)">
                    <MudNavLink Href="navigation-settings" Icon="@Icons.Material.Filled.Tune">Manage Sidebar</MudNavLink>
                </MudNavGroup>
            </Authorized>
        </AuthorizeView>
    </MudNavMenu>

    <MudDivider />

    <AuthorizeView>
        <Authorized>
            <div class="pa-4 d-flex align-center">
                <MudAvatar Color="Color.Primary" Size="Size.Small" Class="mr-2">@Initial</MudAvatar>
                <div class="flex-grow-1" style="min-width: 0;">
                    <MudText Typo="Typo.body2" Class="text-truncate">@context.User.Identity?.Name</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-truncate">@primaryRoleLabel</MudText>
                </div>
            </div>
            <div class="d-flex align-center px-4 pb-4" style="gap: 8px;">
                <MudLink Href="Account/Manage" Typo="Typo.caption">Profile</MudLink>
                <form action="Account/Logout" method="post">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                    <button type="submit" style="background:none;border:none;padding:0;cursor:pointer;" class="mud-typography-caption mud-primary-text">Log out</button>
                </form>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="pa-4">
                <MudButton Href="Account/Login" Color="Color.Primary" Variant="Variant.Filled" FullWidth="true">Login</MudButton>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    // Keep in sync with NavigationSettings.razor's icon picker -- IconKey is
    // stored as this short name (not a literal icon string) so it stays
    // readable in the database and in the management UI.
    public static readonly Dictionary<string, string> IconMap = new()
    {
        ["Person"] = Icons.Material.Filled.Person,
        ["PersonAdd"] = Icons.Material.Filled.PersonAdd,
        ["Group"] = Icons.Material.Filled.Group,
        ["CleaningServices"] = Icons.Material.Filled.CleaningServices,
        ["Business"] = Icons.Material.Filled.Business,
        ["Rule"] = Icons.Material.Filled.Rule,
        ["Schedule"] = Icons.Material.Filled.Schedule,
        ["ReportProblem"] = Icons.Material.Filled.ReportProblem,
        ["History"] = Icons.Material.Filled.History,
        ["MenuBook"] = Icons.Material.Filled.MenuBook,
        ["Badge"] = Icons.Material.Filled.Badge,
        ["UploadFile"] = Icons.Material.Filled.UploadFile,
        ["FactCheck"] = Icons.Material.Filled.FactCheck,
        ["Message"] = Icons.Material.Filled.Message,
        ["ErrorOutline"] = Icons.Material.Filled.ErrorOutline,
        ["ListAlt"] = Icons.Material.Filled.ListAlt,
        ["Settings"] = Icons.Material.Filled.Settings,
        ["Folder"] = Icons.Material.Filled.Folder,
        ["Link"] = Icons.Material.Filled.Link,
    };

    static string ResolveIcon(string? key) =>
        !string.IsNullOrWhiteSpace(key) && IconMap.TryGetValue(key, out var icon) ? icon : Icons.Material.Filled.Circle;

    List<NavSection> sections = new();
    HashSet<string> currentUserRoles = new();
    string? currentUrl;
    string Initial = "?";
    string primaryRoleLabel = "User";
    string searchText = "";

    // Expanded/collapsed state per section (keyed by NavSection.Id, -1 for the
    // built-in Admin group) -- defaults to expanded so nothing looks hidden
    // on first load, same as the reference design.
    readonly Dictionary<int, bool> expandedState = new();
    bool IsExpanded(int sectionId) => !expandedState.TryGetValue(sectionId, out var expanded) || expanded;

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            var name = authState.User.Identity?.Name;
            Initial = !string.IsNullOrWhiteSpace(name) ? name[..1].ToUpperInvariant() : "?";

            var appUser = await UserManager.GetUserAsync(authState.User);
            if (appUser != null)
            {
                currentUserRoles = new HashSet<string>(await UserManager.GetRolesAsync(appUser), StringComparer.OrdinalIgnoreCase);
            }

            var primaryRole = currentUserRoles.FirstOrDefault();
            if (!string.IsNullOrWhiteSpace(primaryRole))
            {
                primaryRoleLabel = char.ToUpperInvariant(primaryRole[0]) + primaryRole[1..];
            }
        }

        sections = await DataManagementService.GetNavSectionsAsync();
    }

    // No roles recorded on the item = visible to any authenticated user.
    // Otherwise the user needs at least one of the comma-separated roles.
    bool IsVisible(NavItem item)
    {
        if (string.IsNullOrWhiteSpace(item.RequiredRoles)) return true;

        var required = item.RequiredRoles.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        return required.Any(r => currentUserRoles.Contains(r));
    }

    bool MatchesSearch(NavItem item) =>
        string.IsNullOrWhiteSpace(searchText) || item.Label.Contains(searchText, StringComparison.OrdinalIgnoreCase);
}
