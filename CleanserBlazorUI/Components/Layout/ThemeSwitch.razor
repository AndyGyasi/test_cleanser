@implements IDisposable
@inject ThemeService ThemeService
@inject IJSRuntime JS
@using CleanserBlazorUI.Services

<div class="cx-segmented" role="group" aria-label="Theme">
    <button type="button" aria-pressed="@(ThemeService.IsDark ? "false" : "true")" @onclick="() => ThemeService.SetAsync(false, JS)">
        <svg class="cx-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16a4 4 0 100-8 4 4 0 000 8zM12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>Light
    </button>
    <button type="button" aria-pressed="@(ThemeService.IsDark ? "true" : "false")" @onclick="() => ThemeService.SetAsync(true, JS)">
        <svg class="cx-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 019.5 4 8 8 0 1020 14.5z"/></svg>Dark
    </button>
</div>

@code {
    [Parameter] public bool InitialDark { get; set; } = true;

    protected override void OnInitialized() => ThemeService.Changed += OnChanged;

    protected override void OnParametersSet() => ThemeService.SetFromCookieValue(InitialDark ? "dark" : "light");

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => ThemeService.Changed -= OnChanged;
}
