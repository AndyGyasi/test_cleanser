@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager
@using CleanserBlazorUI.Theme

<MudThemeProvider @bind-IsDarkMode="@IsDark" Theme="@CleanserTheme.Default" />
@* Explicit @rendermode here matters: MainLayout itself renders statically,
   so without pinning these to InteractiveServer, any page that opts into
   @rendermode InteractiveServer gets its own separate interactive circuit
   boundary that doesn't include these statically-rendered providers --
   MudSelect/MudDatePicker/etc. then throw "Missing <MudPopoverProvider />"
   even though one is right here in the markup. *@
<MudPopoverProvider @rendermode="InteractiveServer" />
<MudDialogProvider @rendermode="InteractiveServer" />
<MudSnackbarProvider @rendermode="InteractiveServer" />

<MudAppBar Fixed="true" Dense="false" Elevation="0">
    <MudLink Href="/">
        <MudImage Style="padding: 5px;" Src="logocolor.png" Height="55" Width="110"></MudImage>
    </MudLink>

    <MudSpacer />
    <AuthorizeView>
        <Authorized>

            <MudLink class="nav-link" href="Account/Manage">
                <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> @context.User.Identity?.Name
            </MudLink>
            <div class="nav-item px-3">
                <form action="Account/Logout" method="post">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                    <button type="submit" class="nav-link">
                        <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Logout
                    </button>
                </form>
            </div>
        </Authorized>
        <NotAuthorized>
            <MudButton Href="Account/Login" Color="Color.Primary" Variant="Variant.Filled">Login</MudButton>
        </NotAuthorized>
    </AuthorizeView>
</MudAppBar>

<MudMainContent Style="overflow: hidden;">
    <MudContainer Style="min-height: 100vh; overflow-y: hidden;" MaxWidth="MaxWidth.ExtraExtraLarge" Class="my-sample-main-content-container my-4 pt-4">
        @Body
        <MudAppBar Bottom="true" Fixed="true" Dense="@true" Elevation="0" Style="width: 100%; padding-top: 10px">
            <MudSpacer></MudSpacer>
            <MudPaper Elevation="0" style="background-color: transparent">
                <div>
                    Cleanser © @DateTime.Now.Year.ToString() <strong>XDS Data</strong>. All rights reserved.
                    <a href="/privacy-policy" style="color: var(--mud-palette-primary); text-decoration: none;">Privacy Policy</a> |
                    <a href="/terms-of-service" style="color: var(--mud-palette-primary); text-decoration: none;">Terms of Service</a> |
                    <a href="/cookie-policy" style="color: var(--mud-palette-primary); text-decoration: none;">Cookie Policy</a>
                </div>
            </MudPaper>
        </MudAppBar>
    </MudContainer>
</MudMainContent>

<div id="blazor-error-ui">
    <a class="dismiss">🗙</a>
</div>

@code {
    public bool IsDark { get; set; } = true;

    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}