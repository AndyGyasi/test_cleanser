@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject ThemeService ThemeService
@using CleanserBlazorUI.Services

@* Theme provider is its own interactive island so the Light/Dark switch
   re-themes every Mud component live; this layout renders statically and
   hands it the theme resolved from the request (query/cookie). *@
<ThemeHost @rendermode="InteractiveServer" InitialDark="@ThemeService.IsDark" />
@* Explicit @rendermode here matters: MainLayout itself renders statically,
   so without pinning these to InteractiveServer, any page that opts into
   @rendermode InteractiveServer gets its own separate interactive circuit
   boundary that doesn't include these statically-rendered providers --
   MudSelect/MudDatePicker/etc. then throw "Missing <MudPopoverProvider />"
   even though one is right here in the markup. *@
<MudPopoverProvider @rendermode="InteractiveServer" />
<MudDialogProvider @rendermode="InteractiveServer" />
<MudSnackbarProvider @rendermode="InteractiveServer" />

@* Signed-out routes (sign-in and friends) render full-bleed with no sidebar --
   those pages draw their own chrome. isAuthenticated is resolved up front in
   OnInitializedAsync (not via <AuthorizeView>, which defers its children
   behind an async render pass), and @Body appears exactly once in the tree
   whatever the state, or Blazor's [SupplyParameterFromForm] form discovery for
   pages like Login breaks with "EditForm requires a Model or EditContext". *@
<div class="cx-shell @(isAuthenticated ? "" : "cx-bare")" id="cx-shell">
    @if (isAuthenticated)
    {
        <NavMenu />
        <div class="cx-scrim" data-cx="close-nav"></div>
    }

    <div class="cx-main">
        @if (isAuthenticated)
        {
            <div class="cx-topbar">
                <button type="button" class="cx-icon-btn" data-cx="open-nav" aria-label="Open menu">
                    <svg class="cx-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
                </button>
                <img src="logocolor.png" alt="XDS Data Ghana" class="cx-topbar-logo" />
            </div>
        }

        <main class="@(isAuthenticated ? "cx-page" : "")">
            @Body
        </main>

        @if (isAuthenticated)
        {
            <footer class="cx-legal">
                <span>Cleanser © @DateTime.Now.Year.ToString() <strong>XDS Data Ghana</strong>. All rights reserved.</span>
                <a href="privacy-policy">Privacy policy</a>
                <a href="terms-of-service">Terms of service</a>
                <a href="cookie-policy">Cookie policy</a>
            </footer>
        }
    </div>
</div>

<div id="blazor-error-ui">
    <a class="dismiss">🗙</a>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    bool isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        // HttpContext is only populated during the initial static render pass
        // (the same pass every page gets before its circuit connects, whether
        // or not the page itself ends up interactive) -- reading the request's
        // theme here means the correct theme applies on first paint everywhere,
        // including static-only pages like Login that never get a circuit.
        ThemeService.SetFromCookieValue(ThemeService.FromRequest(HttpContext));

        if (AuthenticationStateTask != null)
        {
            var authState = await AuthenticationStateTask;
            // A brand-new account is signed in but may only see the set-password
            // page (PasswordChangeMiddleware), so it gets no sidebar or app chrome.
            isAuthenticated = authState.User.Identity?.IsAuthenticated == true
                              && !authState.User.IsInRole(PasswordChangeMiddleware.RoleName)
                              && !IsFullScreenAuthPage();
        }
    }

    // Pages drawn by AuthShell are full-screen and have their own chrome. They stay that way
    // when the visitor happens to be signed in (e.g. following an emailed link), instead of
    // being squeezed inside the sidebar layout.
    private static readonly string[] FullScreenAuthPages =
    {
        "account/login", "account/forgotpassword", "account/forgotpasswordconfirmation",
        "account/resetpassword", "account/resetpasswordconfirmation", "account/lockout",
        "account/confirmemail", "account/invaliduser", "account/resendemailconfirmation",
        "account/changetemporarypassword",
    };

    private bool IsFullScreenAuthPage() =>
        FullScreenAuthPages.Contains(NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0].Trim('/').ToLowerInvariant());
}
