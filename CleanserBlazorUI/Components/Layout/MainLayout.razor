@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@using CleanserBlazorUI.Theme

<MudThemeProvider @bind-IsDarkMode="@IsDark" Theme="@CleanserTheme.Default" />
@* Explicit @rendermode here matters: MainLayout itself renders statically,
   so without pinning these to InteractiveServer, any page that opts into
   @rendermode InteractiveServer gets its own separate interactive circuit
   boundary that doesn't include these statically-rendered providers --
   MudSelect/MudDatePicker/etc. then throw "Missing <MudPopoverProvider />"
   even though one is right here in the markup. *@
<MudPopoverProvider @rendermode="InteractiveServer" />
<MudDialogProvider @rendermode="InteractiveServer" />
<MudSnackbarProvider @rendermode="InteractiveServer" />

<MudLayout>
    @* No top app bar -- the sidebar (logo + nav + user/logout) is the only
       chrome, matching the reference design. This small bar only exists to
       hold the drawer toggle on mobile/narrow screens where the sidebar is
       collapsed by default; it's hidden at desktop widths. *@
    <MudAppBar Fixed="true" Dense="true" Elevation="0" Class="d-flex d-md-none">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@(() => drawerOpen = !drawerOpen)" />
        <MudImage Src="logocolor.png" Height="32" />
    </MudAppBar>

    <MudDrawer @bind-Open="drawerOpen" Elevation="1" Variant="@DrawerVariant.Responsive" Breakpoint="Breakpoint.Md" Width="260px">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="d-flex flex-column" Style="min-height: 100vh;">
        <div class="d-flex justify-end pa-2 d-none d-md-flex">
            <MudTooltip Text="@(IsDark ? "Switch to light theme" : "Switch to dark theme")">
                <MudIconButton Icon="@(IsDark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                               Color="Color.Default" Size="Size.Small" OnClick="ToggleThemeAsync" />
            </MudTooltip>
        </div>
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="flex-grow-1 pb-4">
            @Body
        </MudContainer>
        <MudDivider />
        <div class="d-flex justify-center pa-4">
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Cleanser © @DateTime.Now.Year.ToString() <strong>XDS Data</strong>. All rights reserved.
                <MudLink Href="/privacy-policy" Class="mx-1">Privacy Policy</MudLink> |
                <MudLink Href="/terms-of-service" Class="mx-1">Terms of Service</MudLink> |
                <MudLink Href="/cookie-policy" Class="mx-1">Cookie Policy</MudLink>
            </MudText>
        </div>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
    <a class="dismiss">🗙</a>
</div>

@code {
    public bool IsDark { get; set; } = true;
    bool drawerOpen = true;

    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    // Theme choice is per-browser, not per-account -- read it back from
    // localStorage once the circuit is actually connected (OnInitialized
    // runs before JS interop is available), so a returning visitor doesn't
    // get flashed back to the dark default every page load.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "cleanser-theme");
                if (saved == "light" && IsDark)
                {
                    IsDark = false;
                    StateHasChanged();
                }
                else if (saved == "dark" && !IsDark)
                {
                    IsDark = true;
                    StateHasChanged();
                }
            }
            catch
            {
                // Prerendering or JS interop unavailable yet -- keep the default.
            }
        }
    }

    async Task ToggleThemeAsync()
    {
        IsDark = !IsDark;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "cleanser-theme", IsDark ? "dark" : "light");
        }
        catch
        {
            // Not fatal -- the toggle still works for this session even if saving fails.
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}